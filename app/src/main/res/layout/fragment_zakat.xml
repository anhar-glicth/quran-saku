<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F6"
    android:clickable="true"
    android:focusable="true">

  <!-- Custom App Bar Header -->
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="#FFF9F6"
      android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@android:drawable/ic_menu_revert"
        android:rotation="180"
        android:tint="#8D5C2C"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Kalkulator Zakat"
        android:textColor="#8D5C2C"
        android:textSize="18sp"
        android:textStyle="bold"/>
  </RelativeLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

      <!-- Settings Card (Dynamic Rates) -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="1dp"
          app:cardBackgroundColor="#FFFFFF">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Konfigurasi Harga Pasar"
              android:textColor="#3D2513"
              android:textSize="14sp"
              android:textStyle="bold"
              android:layout_marginBottom="12dp"/>

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal">

            <!-- Harga Emas -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_gold_price"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:hint="Harga Emas / Gram (Rp)"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#FF8F00">
              <com.google.android.material.textfield.TextInputEditText
                  android:id="@+id/et_gold_price"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:inputType="number"
                  android:text="1400000"
                  android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Harga Beras -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/til_rice_price"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:hint="Beras / Kg (Rp)"
                app:boxCornerRadiusBottomEnd="12dp"
                app:boxCornerRadiusBottomStart="12dp"
                app:boxCornerRadiusTopEnd="12dp"
                app:boxCornerRadiusTopStart="12dp"
                app:boxStrokeColor="#FF8F00">
              <com.google.android.material.textfield.TextInputEditText
                  android:id="@+id/et_rice_price"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:inputType="number"
                  android:text="15000"
                  android:textSize="13sp"/>
            </com.google.android.material.textfield.TextInputLayout>

          </LinearLayout>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Custom Tabs Navigation -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:orientation="horizontal"
          android:background="#FFEBE0"
          android:padding="4dp"
          android:layout_marginBottom="16dp"
          android:backgroundTint="#FFEBE0"
          android:elevation="0dp"
          android:gravity="center">

        <TextView
            android:id="@+id/tab_fitrah"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Fitrah"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="@drawable/circle_orange_bg"
            android:backgroundTint="#FF6D00"/>

        <TextView
            android:id="@+id/tab_profesi"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profesi"
            android:textColor="#8D5C2C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>

        <TextView
            android:id="@+id/tab_maal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Maal (Harta)"
            android:textColor="#8D5C2C"
            android:textSize="13sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackground"/>
      </LinearLayout>

      <!-- Input Cards container -->
      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp">

        <!-- Tab 1: Zakat Fitrah Inputs -->
        <LinearLayout
            android:id="@+id/layout_fitrah_inputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:cardCornerRadius="16dp"
              app:cardElevation="1dp"
              app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Kalkulator Zakat Fitrah"
                  android:textColor="#3D2513"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_marginBottom="4dp"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Zakat wajib bagi setiap jiwa Muslim pada bulan Ramadan sebesar 3.5 liter atau 2.5 kg beras."
                  android:textColor="#8D7A6E"
                  android:textSize="11sp"
                  android:layout_marginBottom="16dp"/>

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:hint="Jumlah Jiwa (Anggota Keluarga)"
                  app:boxCornerRadiusBottomEnd="12dp"
                  app:boxCornerRadiusBottomStart="12dp"
                  app:boxCornerRadiusTopEnd="12dp"
                  app:boxCornerRadiusTopStart="12dp"
                  app:boxStrokeColor="#FF8F00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_fitrah_jiwa"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="1"
                    android:textSize="14sp"/>
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
          </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Tab 2: Zakat Profesi Inputs -->
        <LinearLayout
            android:id="@+id/layout_profesi_inputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:cardCornerRadius="16dp"
              app:cardElevation="1dp"
              app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Kalkulator Zakat Profesi"
                  android:textColor="#3D2513"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_marginBottom="4dp"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Zakat penghasilan bulanan. Nisab per bulan setara 522 kg beras. Kadar zakat adalah 2.5%."
                  android:textColor="#8D7A6E"
                  android:textSize="11sp"
                  android:layout_marginBottom="16dp"/>

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:hint="Gaji / Penghasilan Bulanan (Rp)"
                  android:layout_marginBottom="12dp"
                  app:boxCornerRadiusBottomEnd="12dp"
                  app:boxCornerRadiusBottomStart="12dp"
                  app:boxCornerRadiusTopEnd="12dp"
                  app:boxCornerRadiusTopStart="12dp"
                  app:boxStrokeColor="#FF8F00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profesi_gaji"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0"
                    android:textSize="14sp"/>
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:hint="Bonus / Pendapatan Lain (Rp)"
                  android:layout_marginBottom="12dp"
                  app:boxCornerRadiusBottomEnd="12dp"
                  app:boxCornerRadiusBottomStart="12dp"
                  app:boxCornerRadiusTopEnd="12dp"
                  app:boxCornerRadiusTopStart="12dp"
                  app:boxStrokeColor="#FF8F00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profesi_bonus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0"
                    android:textSize="14sp"/>
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:hint="Pengeluaran Kebutuhan Pokok / Hutang (Rp)"
                  app:boxCornerRadiusBottomEnd="12dp"
                  app:boxCornerRadiusBottomStart="12dp"
                  app:boxCornerRadiusTopEnd="12dp"
                  app:boxCornerRadiusTopStart="12dp"
                  app:boxStrokeColor="#FF8F00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_profesi_pengeluaran"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0"
                    android:textSize="14sp"/>
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
          </androidx.cardview.widget.CardView>
        </LinearLayout>

        <!-- Tab 3: Zakat Maal Inputs -->
        <LinearLayout
            android:id="@+id/layout_maal_inputs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
          <androidx.cardview.widget.CardView
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              app:cardCornerRadius="16dp"
              app:cardElevation="1dp"
              app:cardBackgroundColor="#FFFFFF">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Kalkulator Zakat Maal"
                  android:textColor="#3D2513"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_marginBottom="4dp"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Zakat harta yang disimpan selama 1 tahun (haul). Nisab setara 85 gram emas. Kadar zakat adalah 2.5%."
                  android:textColor="#8D7A6E"
                  android:textSize="11sp"
                  android:layout_marginBottom="16dp"/>

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:hint="Uang Tunai / Tabungan / Deposito (Rp)"
                  android:layout_marginBottom="12dp"
                  app:boxCornerRadiusBottomEnd="12dp"
                  app:boxCornerRadiusBottomStart="12dp"
                  app:boxCornerRadiusTopEnd="12dp"
                  app:boxCornerRadiusTopStart="12dp"
                  app:boxStrokeColor="#FF8F00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_maal_tabungan"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0"
                    android:textSize="14sp"/>
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:hint="Emas / Perak / Logam Mulia (Rp)"
                  android:layout_marginBottom="12dp"
                  app:boxCornerRadiusBottomEnd="12dp"
                  app:boxCornerRadiusBottomStart="12dp"
                  app:boxCornerRadiusTopEnd="12dp"
                  app:boxCornerRadiusTopStart="12dp"
                  app:boxStrokeColor="#FF8F00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_maal_emas"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0"
                    android:textSize="14sp"/>
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:hint="Saham / Surat Berharga / Piutang Lancar (Rp)"
                  android:layout_marginBottom="12dp"
                  app:boxCornerRadiusBottomEnd="12dp"
                  app:boxCornerRadiusBottomStart="12dp"
                  app:boxCornerRadiusTopEnd="12dp"
                  app:boxCornerRadiusTopStart="12dp"
                  app:boxStrokeColor="#FF8F00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_maal_saham"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0"
                    android:textSize="14sp"/>
              </com.google.android.material.textfield.TextInputLayout>

              <com.google.android.material.textfield.TextInputLayout
                  style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:hint="Hutang Jatuh Tempo / Mendesak (Rp)"
                  app:boxCornerRadiusBottomEnd="12dp"
                  app:boxCornerRadiusBottomStart="12dp"
                  app:boxCornerRadiusTopEnd="12dp"
                  app:boxCornerRadiusTopStart="12dp"
                  app:boxStrokeColor="#FF8F00">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_maal_hutang"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="0"
                    android:textSize="14sp"/>
              </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
          </androidx.cardview.widget.CardView>
        </LinearLayout>

      </FrameLayout>

      <!-- Result Card -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="20dp"
          app:cardCornerRadius="18dp"
          app:cardElevation="2dp"
          app:cardBackgroundColor="#FFF2EB">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_marginBottom="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hasil Kalkulasi"
                android:textColor="#3D2513"
                android:textSize="16sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <!-- Badge Status Wajib/Tidak -->
            <TextView
                android:id="@+id/tv_zakat_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/circle_peach_bg"
                android:backgroundTint="#E0F2F1"
                android:text="Belum Wajib"
                android:textColor="#004D40"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"/>
          </LinearLayout>

          <!-- Nisab Limit Info -->
          <TextView
              android:id="@+id/tv_nisab_info"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Nisab Zakat: -"
              android:textColor="#5D4037"
              android:textSize="13sp"
              android:layout_marginBottom="14dp"/>

          <!-- Divider -->
          <View
              android:layout_width="match_parent"
              android:layout_height="1dp"
              android:background="#FFD0BC"
              android:layout_marginBottom="14dp"/>

          <!-- Calculated Amount display -->
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Jumlah Zakat yang Harus Dibayar:"
              android:textColor="#8D7A6E"
              android:textSize="11sp"
              android:layout_marginBottom="4dp"/>

          <TextView
              android:id="@+id/tv_zakat_amount"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Rp 0"
              android:textColor="#FF6D00"
              android:textSize="28sp"
              android:textStyle="bold"/>

          <TextView
              android:id="@+id/tv_calculation_notes"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="Masukkan nilai input di atas untuk menghitung otomatis."
              android:textColor="#8D7A6E"
              android:textSize="11sp"
              android:lineSpacingMultiplier="1.2"/>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Pay Zakat Button -->
      <Button
          android:id="@+id/btn_pay"
          android:layout_width="match_parent"
          android:layout_height="50dp"
          android:layout_marginBottom="8dp"
          android:backgroundTint="#2E7D32"
          android:text="Bayar Zakat Sekarang"
          android:textColor="#FFFFFF"
          android:textStyle="bold"
          app:cornerRadius="12dp"
          android:drawablePadding="8dp"
          android:icon="@android:drawable/ic_menu_send"
          style="@style/Widget.MaterialComponents.Button"/>

      <!-- Pay/Share CTA Button -->
      <Button
          android:id="@+id/btn_action"
          android:layout_width="match_parent"
          android:layout_height="50dp"
          android:layout_marginBottom="24dp"
          android:backgroundTint="#FF6D00"
          android:text="Bagikan Hasil Perhitungan"
          android:textColor="#FFFFFF"
          android:textStyle="bold"
          app:cornerRadius="12dp"
          android:drawablePadding="8dp"
          android:icon="@android:drawable/ic_menu_share"
          style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>
  </ScrollView>
</LinearLayout>
