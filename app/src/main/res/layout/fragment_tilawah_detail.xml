<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F4"
    android:clickable="true"
    android:focusable="true">

  <!-- Header -->
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="#FFFFFF"
      android:elevation="2dp"
      android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@android:drawable/ic_menu_revert"
        android:rotation="180"
        android:tint="#FF6D00"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Dashboard Tilawah"
        android:textColor="#FF6D00"
        android:textSize="18sp"
        android:textStyle="bold"/>
  </RelativeLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Terakhir Dibaca Card -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="125dp"
          android:layout_marginBottom="16dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="3dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:src="@drawable/quran_header_bg"
              android:scaleType="centerCrop"/>

          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:padding="16dp">

            <TextView
                android:id="@+id/lbl_last_read"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terakhir Dibaca"
                android:textColor="#FFFDE7"
                android:textSize="12sp"
                android:alpha="0.9"/>

            <TextView
                android:id="@+id/txt_last_read_sura"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/lbl_last_read"
                android:layout_toStartOf="@+id/btn_continue_read"
                android:layout_marginEnd="8dp"
                android:layout_marginTop="4dp"
                android:text="Al-Kahf: Ayat 10"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/txt_last_read_page"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txt_last_read_sura"
                android:layout_marginTop="2dp"
                android:text="Halaman 293"
                android:textColor="#FFFDE7"
                android:textSize="12sp"
                android:alpha="0.8"/>

            <Button
                android:id="@+id/btn_continue_read"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Lanjutkan"
                android:textColor="#FF6D00"
                android:textSize="12sp"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="16dp"
                style="@style/Widget.MaterialComponents.Button"
                app:cornerRadius="18dp"/>

          </RelativeLayout>
        </RelativeLayout>
      </androidx.cardview.widget.CardView>

      <!-- Target Harian Card -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="20dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp"
          app:cardBackgroundColor="#FFFFFF">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Target Tilawah Hari Ini"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/txt_progress_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="1 dari 2 Halaman (50%)"
                android:textColor="#FF6D00"
                android:textSize="12sp"
                android:textStyle="bold"/>

          </RelativeLayout>

          <ProgressBar
              android:id="@+id/progress_daily"
              style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent"
              android:layout_height="8dp"
              android:layout_marginTop="12dp"
              android:progress="50"
              android:progressTint="#FF6D00"
              android:progressBackgroundTint="#EEEEEE"/>

        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Surah Populer Header -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Surah Pilihan"
          android:textColor="#333333"
          android:textSize="16sp"
          android:textStyle="bold"
          android:layout_marginBottom="12dp"/>

      <!-- Surah Grid -->
      <GridLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:columnCount="2"
          android:rowCount="2"
          android:alignmentMode="alignMargins"
          android:columnOrderPreserved="false">

        <!-- Yasin -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_sura_yasin"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="يس"
                android:textColor="#FF6D00"
                android:textSize="28sp"
                android:fontFamily="serif"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Yasin"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surah 36 • 83 Ayat"
                android:textColor="#888888"
                android:textSize="11sp"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Al-Kahf -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_sura_kahf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الكهف"
                android:textColor="#FF6D00"
                android:textSize="28sp"
                android:fontFamily="serif"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Al-Kahf"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surah 18 • 110 Ayat"
                android:textColor="#888888"
                android:textSize="11sp"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Al-Mulk -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_sura_mulk"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الملك"
                android:textColor="#FF6D00"
                android:textSize="28sp"
                android:fontFamily="serif"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Al-Mulk"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surah 67 • 30 Ayat"
                android:textColor="#888888"
                android:textSize="11sp"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Ar-Rahman -->
        <androidx.cardview.widget.CardView
            android:id="@+id/card_sura_rahman"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="6dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الرحمن"
                android:textColor="#FF6D00"
                android:textSize="28sp"
                android:fontFamily="serif"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Ar-Rahman"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surah 55 • 78 Ayat"
                android:textColor="#888888"
                android:textSize="11sp"/>
          </LinearLayout>
        </androidx.cardview.widget.CardView>

      </GridLayout>

    </LinearLayout>
  </ScrollView>
</LinearLayout>
