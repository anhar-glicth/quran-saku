<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F9F9">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="@color/toolbar"
      android:theme="@style/ToolbarStyle"
      app:titleTextAppearance="@style/ToolbarTitleText"/>

  <!-- Info Header Grup -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="#FFFFFF"
      android:padding="20dp"
      android:elevation="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

      <FrameLayout
          android:id="@+id/lay_detail_avatar"
          android:layout_width="50dp"
          android:layout_height="50dp"
          android:background="@drawable/bg_circle_solid"
          android:backgroundTint="#EBF5FB"
          android:layout_centerVertical="true">
        <TextView
            android:id="@+id/txt_detail_initials"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="G"
            android:textColor="#2980B9"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_gravity="center"/>
      </FrameLayout>

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_toEndOf="@id/lay_detail_avatar"
          android:layout_marginStart="14dp"
          android:layout_centerVertical="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

          <TextView
              android:id="@+id/txt_detail_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Nama Grup"
              android:textColor="#212121"
              android:textSize="18sp"
              android:textStyle="bold"/>

          <ImageButton
              android:id="@+id/btn_edit_group"
              android:layout_width="32dp"
              android:layout_height="32dp"
              android:layout_marginStart="8dp"
              android:background="?attr/selectableItemBackgroundBorderless"
              android:src="@android:drawable/ic_menu_edit"
              android:visibility="gone"/>

        </LinearLayout>

        <TextView
            android:id="@+id/txt_detail_code"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="KODE: XXXXXXXX"
            android:textColor="#888888"
            android:textSize="12sp"
            android:typeface="monospace"/>
      </LinearLayout>
    </RelativeLayout>

    <!-- Progress Target Khatam -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

      <TextView
          android:id="@+id/txt_target_desc"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Target: 1x Khatam (30 Hari)"
          android:textColor="#555555"
          android:textSize="12sp"/>

      <TextView
          android:id="@+id/txt_progress_pct"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="0% Selesai"
          android:textColor="@color/accent_color"
          android:textSize="13sp"
          android:textStyle="bold"
          android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/detail_progress_indicator"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:progress="0"
        app:trackColor="#FFE0E0E0"
        app:indicatorColor="@color/accent_color"
        app:trackThickness="8dp"
        app:trackCornerRadius="4dp"/>

  </LinearLayout>

  <!-- Button Lay Lanjutkan & Admin Requests -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:paddingHorizontal="16dp"
      android:paddingVertical="10dp"
      android:background="#FFFFFF"
      android:gravity="center">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_pending_requests"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_marginEnd="8dp"
        android:text="Pending Acc"
        android:textColor="#E65100"
        app:strokeColor="#E65100"
        app:cornerRadius="24dp"
        android:visibility="gone"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_lanjutkan_tilawah"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:text="Lanjutkan Ajian Terakhir"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/accent_color"
        app:cornerRadius="24dp"/>

  </LinearLayout>

  <!-- Tab Title Relay vs Anggota -->
  <com.google.android.material.tabs.TabLayout
      android:id="@+id/tab_layout"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:background="#FFFFFF">
    <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Relay Bacaan"/>
    <com.google.android.material.tabs.TabItem
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Anggota Grup"/>
  </com.google.android.material.tabs.TabLayout>

  <!-- Content List -->
  <FrameLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_detail_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

    <ProgressBar
        android:id="@+id/progress_detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"/>
  </FrameLayout>

</LinearLayout>
