<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nama Grup Ngaji"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_group_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Majelis Tilawah Al-Ikhlas"
            android:textSize="14sp"
            android:inputType="textCapWords"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi Grup / Misi"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_group_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Grup tilawah harian khatam bersama..."
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Target Khatam (Kali)"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_group_khatam"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="1"
            android:textSize="14sp"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Durasi Target (Hari)"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_group_duration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="30"
            android:textSize="14sp"
            android:inputType="number"
            android:layout_marginBottom="16dp"/>

    </LinearLayout>
</ScrollView>
