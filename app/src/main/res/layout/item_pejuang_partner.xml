<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="14dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#FFEAEAEA"
    app:cardBackgroundColor="#FFFFFF">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="16dp"
      android:gravity="center_vertical">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_logo_container"
        android:layout_width="52dp"
        android:layout_height="52dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp"
        app:cardBackgroundColor="#E0F2F1">

      <TextView
          android:id="@+id/tv_partner_logo"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:text="P"
          android:textColor="#004D40"
          android:textStyle="bold"
          android:textSize="14sp"
          android:gravity="center"/>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="16dp">

      <TextView
          android:id="@+id/tv_partner_name"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Nama Lembaga"
          android:textColor="#212121"
          android:textSize="14sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/tv_partner_desc"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Deskripsi kontribusi lembaga dalam program."
          android:textColor="#666666"
          android:textSize="11sp"
          android:layout_marginTop="2dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_partner_role"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mitra"
        android:textColor="#004D40"
        android:textSize="9sp"
        android:textStyle="bold"
        android:background="@drawable/bg_role_badge"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:layout_marginStart="8dp"/>

  </LinearLayout>
</com.google.android.material.card.MaterialCardView>
