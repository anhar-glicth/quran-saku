<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="14dp">

    <!-- Row 1: Surah name + Status badge -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">

      <TextView
          android:id="@+id/tv_item_surah"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_alignParentStart="true"
          android:layout_toStartOf="@+id/tv_item_status"
          android:layout_marginEnd="8dp"
          android:text="Al-Fatihah • Ayat 1 - 7"
          android:textColor="#1A1A1A"
          android:textSize="14sp"
          android:textStyle="bold"
          android:layout_centerVertical="true"/>

      <TextView
          android:id="@+id/tv_item_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_alignParentEnd="true"
          android:layout_centerVertical="true"
          android:text="✅ Lulus"
          android:textSize="12sp"
          android:textStyle="bold"/>
    </RelativeLayout>

    <!-- Progress bar akurasi -->
    <ProgressBar
        android:id="@+id/pb_item_accuracy"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginBottom="6dp"
        android:progress="80"
        android:progressBackgroundTint="#EEEEEE"
        android:progressTint="#4CAF50"/>

    <!-- Row 2: Tanggal + Akurasi persen -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

      <TextView
          android:id="@+id/tv_item_date"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_alignParentStart="true"
          android:layout_centerVertical="true"
          android:text="19 Jun 2026, 11:54"
          android:textColor="#AAAAAA"
          android:textSize="11sp"/>

      <TextView
          android:id="@+id/tv_item_accuracy"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_alignParentEnd="true"
          android:layout_centerVertical="true"
          android:text="80%"
          android:textColor="#2E7D32"
          android:textSize="13sp"
          android:textStyle="bold"/>
    </RelativeLayout>

  </LinearLayout>
</androidx.cardview.widget.CardView>
