<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:orientation="vertical"
    android:background="#FFF9F9F9">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="@color/toolbar"
      android:theme="@style/ToolbarStyle"
      app:titleTextAppearance="@style/ToolbarTitleText"/>

  <!-- Filter Kategori Tab -->
  <HorizontalScrollView
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:scrollbars="none"
      android:background="#FFFFFF"
      android:paddingVertical="12dp"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:elevation="2dp">

    <LinearLayout
        android:id="@+id/tab_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

      <TextView
          android:id="@+id/tab_semua"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:text="✨ Semua"
          android:gravity="center"
          android:paddingHorizontal="16dp"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="#FFFFFF"
          android:background="@drawable/bg_segmented_selected"
          android:layout_marginEnd="8dp"/>

      <TextView
          android:id="@+id/tab_harian"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:text="☀️ Harian"
          android:gravity="center"
          android:paddingHorizontal="16dp"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="#666666"
          android:background="@drawable/bg_segmented_control"
          android:layout_marginEnd="8dp"/>

      <TextView
          android:id="@+id/tab_pagi"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:text="🌅 Pagi"
          android:gravity="center"
          android:paddingHorizontal="16dp"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="#666666"
          android:background="@drawable/bg_segmented_control"
          android:layout_marginEnd="8dp"/>

      <TextView
          android:id="@+id/tab_shalat"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:text="🕌 Shalat"
          android:gravity="center"
          android:paddingHorizontal="16dp"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="#666666"
          android:background="@drawable/bg_segmented_control"
          android:layout_marginEnd="8dp"/>

      <TextView
          android:id="@+id/tab_quran"
          android:layout_width="wrap_content"
          android:layout_height="36dp"
          android:text="📖 Al-Quran"
          android:gravity="center"
          android:paddingHorizontal="16dp"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="#666666"
          android:background="@drawable/bg_segmented_control"
          android:layout_marginEnd="8dp"/>

    </LinearLayout>
  </HorizontalScrollView>

  <!-- RecyclerView Doa -->
  <androidx.recyclerview.widget.RecyclerView
      android:id="@+id/rv_doa_harian"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:padding="16dp"
      android:clipToPadding="false"
      android:scrollbars="none"/>

  <!-- Loading State -->
  <ProgressBar
      android:id="@+id/progress_doa_harian"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_gravity="center"
      android:visibility="gone"/>

</LinearLayout>
