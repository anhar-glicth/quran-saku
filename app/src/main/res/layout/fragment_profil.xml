<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F9F9">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <!-- Profile Header Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FFEAEAEA">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="20dp"
          android:gravity="center">

        <!-- Avatar Placeholder -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFEAEAEA"
            app:strokeWidth="2dp"
            app:strokeColor="@color/accent_color"
            android:layout_marginBottom="12dp">
          <TextView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:text="👤"
              android:textSize="40sp"
              android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Muhammad Anhar Solihin"
            android:textColor="#212121"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="anhar-glicth"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Reading Statistics Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Statistik Tilawah Anda"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Stats Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="20dp">

      <!-- Surah Read Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp"
          app:cardBackgroundColor="#FFFFFF"
          android:layout_marginEnd="4dp"
          app:strokeWidth="1dp"
          app:strokeColor="#FFEAEAEA">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="12"
              android:textColor="@color/accent_color"
              android:textSize="22sp"
              android:textStyle="bold"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Surah"
              android:textColor="#666666"
              android:textSize="12sp"
              android:layout_marginTop="2dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Juz Read Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp"
          app:cardBackgroundColor="#FFFFFF"
          android:layout_marginStart="4dp"
          android:layout_marginEnd="4dp"
          app:strokeWidth="1dp"
          app:strokeColor="#FFEAEAEA">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="3"
              android:textColor="@color/accent_color"
              android:textSize="22sp"
              android:textStyle="bold"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Juz"
              android:textColor="#666666"
              android:textSize="12sp"
              android:layout_marginTop="2dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Streak Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp"
          app:cardBackgroundColor="#FFFFFF"
          android:layout_marginStart="4dp"
          app:strokeWidth="1dp"
          app:strokeColor="#FFEAEAEA">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="5 Hari"
              android:textColor="@color/accent_color"
              android:textSize="22sp"
              android:textStyle="bold"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Konsistensi"
              android:textColor="#666666"
              android:textSize="12sp"
              android:layout_marginTop="2dp" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- App Shortcuts/Menu list -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FFEAEAEA">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">

        <!-- Settings Shortcut -->
        <RelativeLayout
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="⚙️   Pengaturan Aplikasi"
              android:textColor="#212121"
              android:textSize="15sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="#999999"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFEAEAEA"/>

        <!-- Help Shortcut -->
        <RelativeLayout
            android:id="@+id/btn_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="❓   Pusat Bantuan &amp; FAQ"
              android:textColor="#212121"
              android:textSize="15sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="#999999"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFEAEAEA"/>

        <!-- About Shortcut -->
        <RelativeLayout
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="ℹ️   Tentang Kami"
              android:textColor="#212121"
              android:textSize="15sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="#999999"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_alignParentEnd="true"/>
        </RelativeLayout>

      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

  </LinearLayout>
</ScrollView>
