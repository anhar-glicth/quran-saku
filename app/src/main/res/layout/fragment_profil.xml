<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface"
    android:fillViewport="true">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:paddingStart="16dp"
      android:paddingEnd="16dp"
      android:paddingTop="20dp"
      android:paddingBottom="32dp">

    <!-- Header: Konfigurasi -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Konfigurasi"
        android:textColor="@color/title_color"
        android:textSize="24sp"
        android:textStyle="bold"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="2dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Personalisasi pengalaman spiritual Anda"
        android:textColor="@color/text_hint_color"
        android:textSize="13sp"
        android:layout_marginBottom="20dp"/>

    <!-- Profile Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/secondary_dark_background"
        android:layout_marginBottom="14dp"
        app:strokeWidth="0dp">

      <RelativeLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:padding="16dp">

        <!-- Avatar Circle -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFEACF"
            app:strokeWidth="0dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true">
          <TextView
              android:id="@+id/tv_avatar_text"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:text="👤"
              android:textSize="22sp"
              android:textStyle="bold"
              android:textColor="@color/accent_color"
              android:gravity="center"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Name & Role -->
        <LinearLayout
            android:id="@+id/layout_user_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/card_avatar"
            android:layout_centerVertical="true"
            android:layout_marginStart="12dp">

          <TextView
              android:id="@+id/tv_user_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Nama User"
              android:textColor="@color/title_color"
              android:textSize="15sp"
              android:textStyle="bold"/>

          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:layout_marginTop="2dp">
            <TextView
                android:id="@+id/tv_user_role"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="User"
                android:textColor="@color/text_hint_color"
                android:textSize="12sp"/>
            <TextView
                android:id="@+id/tv_user_email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" • user@quransaku.com"
                android:textColor="@color/text_hint_color"
                android:textSize="12sp"/>
          </LinearLayout>

          <!-- Edit & Logout Buttons -->
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:layout_marginTop="6dp"
              android:gravity="center_vertical">
            <TextView
                android:id="@+id/btn_edit_profil"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EDIT PROFIL"
                android:textColor="@color/accent_color"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  •  "
                android:textColor="#CCCCCC"
                android:textSize="11sp"/>
            <TextView
                android:id="@+id/btn_logout_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KELUAR"
                android:textColor="#E53E3E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>
          </LinearLayout>

        </LinearLayout>

      </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Settings Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/secondary_dark_background"
        android:layout_marginBottom="14dp"
        app:strokeWidth="0dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <!-- Settings Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="⚙️"
              android:textSize="18sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="  Setting"
              android:textColor="@color/title_color"
              android:textSize="16sp"
              android:textStyle="bold"/>
        </LinearLayout>

        <!-- Mode Gelap -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_centerVertical="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mode Gelap"
                android:textColor="@color/title_color"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ubah ke tampilan gelap"
                android:textColor="@color/text_hint_color"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
          </LinearLayout>
          <Switch
              android:id="@+id/switch_dark_mode"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:checked="false"
              android:thumbTint="@color/accent_color"
              android:trackTint="#CCCCCC"/>
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0EDE8"
            android:layout_marginBottom="14dp"/>

        <!-- Notifikasi Adzan -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="14dp">
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_centerVertical="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Notifikasi Adzan"
                android:textColor="@color/title_color"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aktif untuk 5 waktu shalat"
                android:textColor="@color/text_hint_color"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>
          </LinearLayout>
          <Switch
              android:id="@+id/switch_adzan"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:checked="true"
              android:thumbTint="@color/accent_color"
              android:trackTint="#F5C6A0"/>
        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#F0EDE8"
            android:layout_marginBottom="14dp"/>

        <!-- Bahasa Aplikasi -->
        <RelativeLayout
            android:id="@+id/btn_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Bahasa Aplikasi"
              android:textColor="@color/title_color"
              android:textSize="14sp"
              android:layout_centerVertical="true"/>
          <LinearLayout
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Indonesia"
                android:textColor="@color/accent_color"
                android:textSize="13sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 🌐"
                android:textSize="13sp"/>
          </LinearLayout>
        </RelativeLayout>

      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Customer Service Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/secondary_dark_background"
        android:layout_marginBottom="14dp"
        app:strokeWidth="0dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <!-- CS Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="🎧"
              android:textSize="18sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="  Customer Service"
              android:textColor="@color/title_color"
              android:textSize="16sp"
              android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Butuh bantuan atau ingin memberikan saran? Tim kami siap membantu Anda 24/7."
            android:textColor="@color/text_hint_color"
            android:textSize="13sp"
            android:layout_marginBottom="14dp"/>

        <!-- CS Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

          <!-- Live Chat Button -->
          <com.google.android.material.button.MaterialButton
              android:id="@+id/btn_live_chat"
              android:layout_width="0dp"
              android:layout_height="48dp"
              android:layout_weight="1"
              android:text="LIVE CHAT"
              android:textSize="12sp"
              android:textColor="#FFFFFF"
              android:layout_marginEnd="8dp"
              app:backgroundTint="@color/accent_color"
              app:cornerRadius="12dp"
              app:icon="@android:drawable/ic_dialog_email"
              app:iconTint="#FFFFFF"
              app:iconSize="16dp"
              app:iconGravity="textStart"/>

          <!-- FAQ Button -->
          <com.google.android.material.button.MaterialButton
              android:id="@+id/btn_help"
              android:layout_width="0dp"
              android:layout_height="48dp"
              android:layout_weight="1"
              android:text="FAQ"
              android:textSize="12sp"
              android:textColor="@color/accent_color"
              style="@style/Widget.MaterialComponents.Button.OutlinedButton"
              app:cornerRadius="12dp"
              app:strokeColor="@color/accent_color"
              app:strokeWidth="1dp"
              app:icon="@android:drawable/ic_dialog_info"
              app:iconTint="@color/accent_color"
              app:iconSize="16dp"
              app:iconGravity="textStart"/>

        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Tentang Kami Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:cardBackgroundColor="@color/secondary_dark_background"
        android:layout_marginBottom="16dp"
        app:strokeWidth="0dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <!-- Tentang Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="ℹ️"
              android:textSize="18sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="  Tentang Kami"
              android:textColor="@color/title_color"
              android:textSize="16sp"
              android:textStyle="bold"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Quran Saku adalah aplikasi Al-Quran gratis yang dikembangkan oleh Amal Abadi Palestina (adtin), bekerja sama dengan Velora.id untuk mendekatkan umat dengan Al-Qur'an melalui teknologi modern."
            android:textColor="@color/text_hint_color"
            android:textSize="13sp"
            android:lineSpacingMultiplier="1.4"
            android:layout_marginBottom="16dp"/>

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1M+"
                android:textColor="@color/title_color"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PEMBACA"
                android:textColor="@color/text_hint_color"
                android:textSize="10sp"
                android:letterSpacing="0.1"/>
          </LinearLayout>

          <View
              android:layout_width="1dp"
              android:layout_height="32dp"
              android:background="#EEEEEE"
              android:layout_gravity="center_vertical"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4.9"
                android:textColor="@color/title_color"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RATING"
                android:textColor="@color/text_hint_color"
                android:textSize="10sp"
                android:letterSpacing="0.1"/>
          </LinearLayout>

          <View
              android:layout_width="1dp"
              android:layout_height="32dp"
              android:background="#EEEEEE"
              android:layout_gravity="center_vertical"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="v2.4.0"
                android:textColor="@color/title_color"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VERSI"
                android:textColor="@color/text_hint_color"
                android:textSize="10sp"
                android:letterSpacing="0.1"/>
          </LinearLayout>

        </LinearLayout>

        <!-- Pelajari Lebih Lanjut Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_about"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="PELAJARI LEBIH LANJUT"
            android:textSize="13sp"
            android:textColor="@color/accent_color"
            android:letterSpacing="0.05"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            app:cornerRadius="28dp"
            app:strokeColor="@color/accent_color"
            app:strokeWidth="1dp"/>

      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Menu Settings Shortcut (tersembunyi, tetap ada untuk akses pengaturan) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/secondary_dark_background"
        android:layout_marginBottom="16dp"
        app:strokeWidth="0dp">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/btn_settings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="⚙️   Pengaturan Aplikasi"
              android:textColor="@color/title_color"
              android:textSize="14sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="#BBBBBB"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_alignParentEnd="true"/>
        </RelativeLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Logout Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="@color/secondary_dark_background"
        android:layout_marginBottom="16dp"
        app:strokeWidth="0dp">
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical">
        <RelativeLayout
            android:id="@+id/btn_logout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackground"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="🚪   Keluar dari Akun"
              android:textColor="#E53E3E"
              android:textSize="14sp"
              android:textStyle="bold"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="#E53E3E"
              android:textSize="20sp"
              android:textStyle="bold"
              android:layout_alignParentEnd="true"/>
        </RelativeLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Footer Links -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp">

      <TextView
          android:id="@+id/btn_privacy"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Kebijakan Privasi"
          android:textColor="@color/text_hint_color"
          android:textSize="11sp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:clickable="true"
          android:focusable="true"/>

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text=" · "
          android:textColor="#CCCCCC"
          android:textSize="11sp"/>

      <TextView
          android:id="@+id/btn_terms"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Syarat &amp; Ketentuan"
          android:textColor="@color/text_hint_color"
          android:textSize="11sp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:clickable="true"
          android:focusable="true"/>

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text=" · "
          android:textColor="#CCCCCC"
          android:textSize="11sp"/>

      <TextView
          android:id="@+id/btn_license"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Lisensi Font"
          android:textColor="@color/text_hint_color"
          android:textSize="11sp"
          android:background="?android:attr/selectableItemBackgroundBorderless"
          android:clickable="true"
          android:focusable="true"/>

    </LinearLayout>

  </LinearLayout>
</ScrollView>
