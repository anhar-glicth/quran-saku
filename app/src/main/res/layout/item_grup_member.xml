<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:paddingHorizontal="16dp">

        <!-- Avatar Bulat -->
        <FrameLayout
            android:id="@+id/lay_member_avatar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_circle_solid"
            android:backgroundTint="#E8F5E9"
            android:layout_centerVertical="true">
            <TextView
                android:id="@+id/txt_member_initials"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="US"
                android:textColor="#2E7D32"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Informasi Anggota -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/lay_member_avatar"
            android:layout_toStartOf="@id/lay_member_action"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txt_member_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nama Anggota"
                android:textColor="#212121"
                android:textSize="13sp"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/txt_member_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Halaman Terakhir: 15"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Aksi Member (Untuk Admin: Approve/Reject, Untuk user: Tampil Halaman) -->
        <LinearLayout
            android:id="@+id/lay_member_action"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <!-- Tombol Terima (Admin Pending only) -->
            <TextView
                android:id="@+id/btn_approve"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Terima"
                android:textColor="#FFFFFF"
                android:background="@drawable/bg_segmented_selected"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Tombol Tolak (Admin Pending only) -->
            <TextView
                android:id="@+id/btn_reject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tolak"
                android:textColor="#C62828"
                android:background="@drawable/bg_button_outline"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:visibility="gone"
                android:clickable="true"
                android:focusable="true"/>

            <!-- Progress Teks biasa (Active member only) -->
            <TextView
                android:id="@+id/txt_member_progress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 hlm"
                android:textColor="@color/accent_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="visible"/>
        </LinearLayout>
    </RelativeLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#FFEAEAEA" />
</LinearLayout>
