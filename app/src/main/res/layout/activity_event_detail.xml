<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/primary_dark_background">

    <!-- AppBar with collapsing banner -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_event_detail"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:fitsSystemWindows="true"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

        <com.google.android.material.appbar.CollapsingToolbarLayout
            android:id="@+id/collapsing_toolbar_event"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fitsSystemWindows="true"
            app:layout_scrollFlags="scroll|exitUntilCollapsed"
            app:contentScrim="@color/accent_color"
            app:expandedTitleTextAppearance="@android:style/TextAppearance.Medium">

            <ImageView
                android:id="@+id/img_event_detail_banner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_home_verse_card"
                android:fitsSystemWindows="true"
                app:layout_collapseMode="parallax"/>

            <!-- Gradient overlay -->
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/gradient_bottom_dark"
                app:layout_collapseMode="parallax"/>

            <!-- Category badge on banner -->
            <TextView
                android:id="@+id/tv_detail_category_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="64dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:text="KAJIAN"
                android:textColor="#FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold"
                android:background="@color/accent_color"
                app:layout_collapseMode="parallax"/>

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar_event_detail"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                app:layout_collapseMode="pin"
                app:popupTheme="@style/ThemeOverlay.AppCompat.Light"/>
        </com.google.android.material.appbar.CollapsingToolbarLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Event Title -->
            <TextView
                android:id="@+id/tv_detail_event_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Judul Event"
                android:textColor="@color/title_color"
                android:textSize="22sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Info Cards Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="20dp">

                <!-- Tanggal & Waktu -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:text="📅"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tanggal &amp; Waktu"
                            android:textColor="@color/text_hint_color"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tv_detail_datetime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Senin, 1 Jan 2025 • 09:00 - 11:00"
                            android:textColor="@color/title_color"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Pemateri -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:text="🎙️"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Pemateri"
                            android:textColor="@color/text_hint_color"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tv_detail_speaker"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ustadz ..."
                            android:textColor="@color/title_color"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Lokasi -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:text="📍"
                        android:textSize="16sp"
                        android:gravity="center"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Lokasi"
                            android:textColor="@color/text_hint_color"
                            android:textSize="11sp"/>

                        <TextView
                            android:id="@+id/tv_detail_location"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Masjid / Online"
                            android:textColor="@color/title_color"
                            android:textSize="13sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/divider_color"
                android:layout_marginBottom="20dp"/>

            <!-- Deskripsi -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tentang Event"
                android:textColor="@color/title_color"
                android:textSize="15sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:id="@+id/tv_detail_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Deskripsi event..."
                android:textColor="@color/text_primary_color"
                android:textSize="14sp"
                android:lineSpacingMultiplier="1.6"
                android:layout_marginBottom="32dp"/>

            <!-- Tombol Daftar -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_register_event"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="✅ Daftar Kegiatan Ini"
                android:textSize="15sp"
                android:textStyle="bold"
                app:cornerRadius="12dp"
                android:backgroundTint="@color/accent_color"/>

            <!-- Tombol Lihat Pendaftar (Admin Only) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_view_registrants"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="👥 Lihat Pendaftar (Admin)"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                app:cornerRadius="12dp"
                android:backgroundTint="#334CAF50"
                android:textColor="#4CAF50"
                android:visibility="gone"
                app:strokeColor="#4CAF50"
                app:strokeWidth="1dp"/>

            <!-- Tombol Edit (Admin Only) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_edit_event_detail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="✏️ Edit Event"
                android:textSize="14sp"
                android:layout_marginTop="10dp"
                app:cornerRadius="12dp"
                android:backgroundTint="#33FF6D00"
                android:textColor="@color/accent_color"
                android:visibility="gone"
                app:strokeColor="@color/accent_color"
                app:strokeWidth="1dp"/>

            <!-- Tombol Hapus (Admin Only) -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_delete_event_detail"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="🗑️ Hapus Event"
                android:textSize="14sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                app:cornerRadius="12dp"
                android:backgroundTint="#33F44336"
                android:textColor="#F44336"
                android:visibility="gone"
                app:strokeColor="#F44336"
                app:strokeWidth="1dp"/>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
