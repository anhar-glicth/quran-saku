<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8F4"
    android:clickable="true"
    android:focusable="true">

  <!-- Header -->
  <RelativeLayout
      android:id="@+id/header_layout"
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="#FFFFFF"
      android:elevation="2dp"
      android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@android:drawable/ic_menu_revert"
        android:rotation="180"
        android:tint="#FF6D00"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Tracker Hafalan Tahfidz"
        android:textColor="#FF6D00"
        android:textSize="18sp"
        android:textStyle="bold"/>
  </RelativeLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:layout_below="@id/header_layout"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Statistics Card -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="20dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:background="#FFFFFF">

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="4"
                android:textColor="#FF6D00"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Target Hafalan"
                android:textColor="#666666"
                android:textSize="11sp"/>
          </LinearLayout>

          <View
              android:layout_width="1dp"
              android:layout_height="40dp"
              android:background="#DDDDDD"
              android:layout_gravity="center_vertical"/>

          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:gravity="center">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2"
                android:textColor="#4CAF50"
                android:textSize="24sp"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Selesai (100%)"
                android:textColor="#666666"
                android:textSize="11sp"/>
          </LinearLayout>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Target List Header -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Hafalan Saya"
          android:textColor="#333333"
          android:textSize="16sp"
          android:textStyle="bold"
          android:layout_marginBottom="12dp"/>

      <!-- Target Item 1 (Juz 30) -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Juz 30 (Juz 'Amma)"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="75%"
                android:textColor="#FF6D00"
                android:textStyle="bold"
                android:textSize="14sp"/>
          </RelativeLayout>
          <ProgressBar
              style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent"
              android:layout_height="6dp"
              android:layout_marginTop="8dp"
              android:progress="75"
              android:progressTint="#FF6D00"
              android:progressBackgroundTint="#EEEEEE"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="Terakhir dihafal: An-Naba Ayat 1-40"
              android:textColor="#888888"
              android:textSize="11sp"/>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Target Item 2 (Al-Mulk) -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Surah Al-Mulk"
                android:textColor="#333333"
                android:textStyle="bold"
                android:textSize="14sp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="Lengkap"
                android:textColor="#4CAF50"
                android:textStyle="bold"
                android:textSize="12sp"/>
          </RelativeLayout>
          <ProgressBar
              style="?android:attr/progressBarStyleHorizontal"
              android:layout_width="match_parent"
              android:layout_height="6dp"
              android:layout_marginTop="8dp"
              android:progress="100"
              android:progressTint="#4CAF50"
              android:progressBackgroundTint="#EEEEEE"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginTop="8dp"
              android:text="Alhamdulillah, 30 ayat telah selesai dihafal."
              android:textColor="#888888"
              android:textSize="11sp"/>
        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Add Target Button -->
      <Button
          android:id="@+id/btn_add_target"
          android:layout_width="match_parent"
          android:layout_height="48dp"
          android:layout_marginTop="8dp"
          android:text="+ Tambah Target Hafalan Baru"
          android:textColor="#FFFFFF"
          android:textSize="14sp"
          android:textStyle="bold"
          android:backgroundTint="#FF6D00"
          app:cornerRadius="8dp"
          style="@style/Widget.MaterialComponents.Button"/>

    </LinearLayout>
  </ScrollView>
</RelativeLayout>
