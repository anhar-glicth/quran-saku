<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F9F9"
    android:scrollbars="none">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp"
      android:clipToPadding="false">

    <!-- Card Doa Hari Ini -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_doa_hari_ini"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="16dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:background="@drawable/bg_card_doa"
          android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="DOA HARI INI"
            android:textColor="#FFEBE0"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <TextView
            android:id="@+id/txt_doa_arab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="رَبِّ زِدْنِي عِلْمًا"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:gravity="end"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/txt_doa_latin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="&quot;Ya Tuhanku, tambahkanlah kepadaku ilmu pengetahuan.&quot;"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:layout_marginBottom="18dp"
            android:lineSpacingMultiplier="1.2" />

        <LinearLayout
            android:id="@+id/btn_aamiinkan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@drawable/bg_button_aamiinkan"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

          <ImageView
              android:layout_width="16dp"
              android:layout_height="16dp"
              android:src="@drawable/ic_hands_pray"
              app:tint="#FFFFFF" />

          <TextView
              android:id="@+id/txt_aamiin_count"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Aamiinkan"
              android:textColor="#FFFFFF"
              android:textSize="12sp"
              android:textStyle="bold"
              android:layout_marginStart="8dp" />
        </LinearLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quick Action Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        android:weightSum="4">

      <!-- Action Doa -->
      <LinearLayout
          android:id="@+id/btn_menu_doa"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center"
          android:clickable="true"
          android:focusable="true">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="13dp">
          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:src="@drawable/ic_hands_pray"
              app:tint="@color/accent_color" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Doa"
            android:textColor="#783A06"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
      </LinearLayout>

      <!-- Action Rank -->
      <LinearLayout
          android:id="@+id/btn_menu_rank"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center"
          android:clickable="true"
          android:focusable="true">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="13dp">
          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:src="@drawable/ic_medal"
              app:tint="@color/accent_color" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rank"
            android:textColor="#783A06"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
      </LinearLayout>

      <!-- Action Grup Ngaji -->
      <LinearLayout
          android:id="@+id/btn_menu_grup"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center"
          android:clickable="true"
          android:focusable="true">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="13dp">
          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:src="@drawable/ic_komunitas"
              app:tint="@color/accent_color" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Grup Ngaji"
            android:textColor="#783A06"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
      </LinearLayout>

      <!-- Action Pejuang Quran -->
      <LinearLayout
          android:id="@+id/btn_menu_pejuang"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:orientation="vertical"
          android:gravity="center"
          android:clickable="true"
          android:focusable="true">

        <FrameLayout
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle_icon"
            android:padding="13dp">
          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:src="@drawable/ic_quran_book"
              app:tint="@color/accent_color" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="pejuang quran"
            android:textColor="#783A06"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginTop="6dp" />
      </LinearLayout>
    </LinearLayout>

    <!-- Titip Doa Section Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Titip Doa"
          android:textColor="#212121"
          android:textSize="17sp"
          android:textStyle="bold" />

      <TextView
          android:id="@+id/txt_lihat_semua"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Lihat Semua"
          android:textColor="@color/accent_color"
          android:textSize="12sp"
          android:textStyle="bold"
          android:layout_alignParentEnd="true"
          android:layout_centerVertical="true"
          android:clickable="true"
          android:focusable="true" />
    </RelativeLayout>

    <!-- Titip Doa Horizontal Scroll -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="24dp"
        android:clipToPadding="false">

      <LinearLayout
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal">

        <!-- Card Doa 1 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_marginVertical="2dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFEAEAEA"
            app:cardBackgroundColor="#FFFFFF">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">



            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

              <FrameLayout
                  android:layout_width="36dp"
                  android:layout_height="36dp"
                  android:background="@drawable/bg_circle_solid"
                  android:backgroundTint="#FFE0B2">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FA"
                    android:textColor="#E65100"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
              </FrameLayout>

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fatimah Az-Zahra"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2 jam yang lalu"
                    android:textColor="#888888"
                    android:textSize="11sp" />
              </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mohon doanya agar dilancarkan ujian akhir semester dan diberikan ilmu yang berkah dunia akhirat...."
                android:textColor="#333333"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp"
                android:minLines="3"
                android:maxLines="3"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="#888888" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="128"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
              </LinearLayout>

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_comment_outline"
                    app:tint="#888888" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="24"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Card Doa 2 -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:layout_marginVertical="2dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFEAEAEA"
            app:cardBackgroundColor="#FFFFFF">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:gravity="center_vertical">

              <FrameLayout
                  android:layout_width="36dp"
                  android:layout_height="36dp"
                  android:background="@drawable/bg_circle_solid"
                  android:backgroundTint="#B3E5FC">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AF"
                    android:textColor="#01579B"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
              </FrameLayout>

              <LinearLayout
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"
                  android:orientation="vertical"
                  android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ahmad Farhan"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5 jam yang lalu"
                    android:textColor="#888888"
                    android:textSize="11sp" />
              </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Semoga kita semua diberikan keistiqomahan dalam membaca Al-Quran setiap hari dan mendapat keberkahan..."
                android:textColor="#333333"
                android:textSize="12sp"
                android:lineSpacingMultiplier="1.2"
                android:layout_marginBottom="12dp"
                android:minLines="3"
                android:maxLines="3"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical"
                  android:layout_marginEnd="16dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_heart_outline"
                    app:tint="#888888" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="85"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
              </LinearLayout>

              <LinearLayout
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="horizontal"
                  android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_comment_outline"
                    app:tint="#888888" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12"
                    android:textColor="#666666"
                    android:textSize="11sp"
                    android:layout_marginStart="4dp" />
              </LinearLayout>
            </LinearLayout>
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

      </LinearLayout>
    </HorizontalScrollView>

    <!-- Leaderboard Section Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp">

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Leaderboard Ngaji"
          android:textColor="#212121"
          android:textSize="17sp"
          android:textStyle="bold"
          android:layout_centerVertical="true" />

      <!-- Segmented Control Toggle -->
      <LinearLayout
          android:id="@+id/layout_leaderboard_toggle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:background="@drawable/bg_segmented_control"
          android:layout_alignParentEnd="true"
          android:layout_centerVertical="true"
          android:padding="2dp">

        <TextView
            android:id="@+id/txt_toggle_mingguan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mingguan"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_segmented_selected"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/txt_toggle_bulanan"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bulanan"
            android:textColor="#666666"
            android:background="@null"
            android:textSize="10sp"
            android:textStyle="bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="5dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
      </LinearLayout>
    </RelativeLayout>

    <!-- Leaderboard List Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="14dp"
        app:cardElevation="1dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FFEAEAEA"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="24dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:paddingHorizontal="16dp"
          android:paddingVertical="8dp">

        <!-- Leaderboard Row 1 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">

          <TextView
              android:id="@+id/txt_rank_1"
              android:layout_width="20dp"
              android:layout_height="wrap_content"
              android:text="1"
              android:textColor="#783A06"
              android:textSize="15sp"
              android:textStyle="bold"
              android:layout_centerVertical="true" />

          <FrameLayout
              android:id="@+id/lay_initials_1"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_toEndOf="@id/txt_rank_1"
              android:layout_marginStart="8dp"
              android:background="@drawable/bg_circle_solid"
              android:backgroundTint="#FDF2E9"
              android:layout_centerVertical="true">
            <TextView
                android:id="@+id/txt_initials_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="KT"
                android:textColor="#E28743"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
          </FrameLayout>

          <LinearLayout
              android:id="@+id/lay_text_1"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_toEndOf="@id/lay_initials_1"
              android:layout_toStartOf="@id/lay_progress_1"
              android:layout_marginStart="12dp"
              android:layout_marginEnd="12dp"
              android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txt_name_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Keluarga Taqwa"
                android:textColor="#212121"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_desc_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Anggota Aktif"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
          </LinearLayout>

          <LinearLayout
              android:id="@+id/lay_progress_1"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:gravity="end"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txt_progress_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.450"
                android:textColor="#783A06"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AYAH SELESAI"
                android:textColor="#888888"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
          </LinearLayout>
        </RelativeLayout>

        <!-- Divider 1 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFEAEAEA" />

        <!-- Leaderboard Row 2 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">

          <TextView
              android:id="@+id/txt_rank_2"
              android:layout_width="20dp"
              android:layout_height="wrap_content"
              android:text="2"
              android:textColor="#783A06"
              android:textSize="15sp"
              android:textStyle="bold"
              android:layout_centerVertical="true" />

          <FrameLayout
              android:id="@+id/lay_initials_2"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_toEndOf="@id/txt_rank_2"
              android:layout_marginStart="8dp"
              android:background="@drawable/bg_circle_solid"
              android:backgroundTint="#EBF5FB"
              android:layout_centerVertical="true">
            <TextView
                android:id="@+id/txt_initials_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MQ"
                android:textColor="#2980B9"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
          </FrameLayout>

          <LinearLayout
              android:id="@+id/lay_text_2"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_toEndOf="@id/lay_initials_2"
              android:layout_toStartOf="@id/lay_progress_2"
              android:layout_marginStart="12dp"
              android:layout_marginEnd="12dp"
              android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txt_name_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Majelis Quran Jakarta"
                android:textColor="#212121"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_desc_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45 Anggota Aktif"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
          </LinearLayout>

          <LinearLayout
              android:id="@+id/lay_progress_2"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:gravity="end"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txt_progress_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2.120"
                android:textColor="#783A06"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AYAH SELESAI"
                android:textColor="#888888"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
          </LinearLayout>
        </RelativeLayout>

        <!-- Divider 2 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#FFEAEAEA" />

        <!-- Leaderboard Row 3 -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="12dp">

          <TextView
              android:id="@+id/txt_rank_3"
              android:layout_width="20dp"
              android:layout_height="wrap_content"
              android:text="3"
              android:textColor="#783A06"
              android:textSize="15sp"
              android:textStyle="bold"
              android:layout_centerVertical="true" />

          <FrameLayout
              android:id="@+id/lay_initials_3"
              android:layout_width="40dp"
              android:layout_height="40dp"
              android:layout_toEndOf="@id/txt_rank_3"
              android:layout_marginStart="8dp"
              android:background="@drawable/bg_circle_solid"
              android:backgroundTint="#F2F3F4"
              android:layout_centerVertical="true">
            <TextView
                android:id="@+id/txt_initials_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SF"
                android:textColor="#7F8C8D"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_gravity="center" />
          </FrameLayout>

          <LinearLayout
              android:id="@+id/lay_text_3"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_toEndOf="@id/lay_initials_3"
              android:layout_toStartOf="@id/lay_progress_3"
              android:layout_marginStart="12dp"
              android:layout_marginEnd="12dp"
              android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txt_name_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sahabat Fillah"
                android:textColor="#212121"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txt_desc_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 Anggota Aktif"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
          </LinearLayout>

          <LinearLayout
              android:id="@+id/lay_progress_3"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:gravity="end"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true">

            <TextView
                android:id="@+id/txt_progress_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1.980"
                android:textColor="#783A06"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AYAH SELESAI"
                android:textColor="#888888"
                android:textSize="8sp"
                android:textStyle="bold"
                android:layout_marginTop="1dp" />
          </LinearLayout>
        </RelativeLayout>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Penyebar Al-Quran Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Penyebar Al-Quran"
        android:textColor="#212121"
        android:textSize="17sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp" />

    <!-- Donation Card 1 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="16dp">

      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="170dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_donasi_maluku"
            android:scaleType="centerCrop" />

        <!-- Scrim Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <!-- Card Content Container -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

          <TextView
              android:id="@+id/txt_donasi_title_1"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Donasi Quran untuk Pedalaman Maluku"
              android:textColor="#FFFFFF"
              android:textSize="15sp"
              android:textStyle="bold"
              android:layout_alignParentTop="true" />

          <!-- Bottom elements aligned relative to each other -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_alignParentBottom="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="85% Terkumpul"
                  android:textColor="#E0E0E0"
                  android:textSize="11sp" />

              <TextView
                  android:id="@+id/btn_donasi_maluku"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Donasi Sekarang"
                  android:textColor="#FFB300"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:layout_alignParentEnd="true"
                  android:clickable="true"
                  android:focusable="true" />
            </RelativeLayout>

            <!-- Custom Progress Indicator -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="85"
                app:trackColor="#4DFFFFFF"
                app:indicatorColor="#FFB300"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp" />
          </LinearLayout>
        </RelativeLayout>
      </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Donation Card 2 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:strokeWidth="0dp"
        android:layout_marginBottom="16dp">

      <FrameLayout
          android:layout_width="match_parent"
          android:layout_height="170dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/img_wakaf_braille"
            android:scaleType="centerCrop" />

        <!-- Scrim Overlay -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#99000000" />

        <!-- Card Content Container -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

          <TextView
              android:id="@+id/txt_donasi_title_2"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:text="Wakaf Quran Braille Nasional"
              android:textColor="#FFFFFF"
              android:textSize="15sp"
              android:textStyle="bold"
              android:layout_alignParentTop="true" />

          <!-- Bottom elements aligned relative to each other -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:layout_alignParentBottom="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="40% Terkumpul"
                  android:textColor="#E0E0E0"
                  android:textSize="11sp" />

              <TextView
                  android:id="@+id/btn_donasi_braille"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Donasi Sekarang"
                  android:textColor="#FFB300"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:layout_alignParentEnd="true"
                  android:clickable="true"
                  android:focusable="true" />
            </RelativeLayout>

            <!-- Custom Progress Indicator -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="40"
                app:trackColor="#4DFFFFFF"
                app:indicatorColor="#FFB300"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp" />
          </LinearLayout>
        </RelativeLayout>
      </FrameLayout>
    </com.google.android.material.card.MaterialCardView>

  </LinearLayout>
</ScrollView>
