<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F9F9">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:padding="16dp">

    <!-- Active Khatam Challenge Card -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tantangan Khatam Bersama"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FFEAEAEA">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Khatam Bersama Dzulhijjah"
              android:textColor="#212121"
              android:textSize="16sp"
              android:textStyle="bold"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="75% Selesai"
              android:textColor="@color/accent_color"
              android:textSize="14sp"
              android:textStyle="bold"
              android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:progress="75"
            app:trackColor="#FFE0E0E0"
            app:indicatorColor="@color/accent_color"
            app:trackThickness="8dp"
            app:trackCornerRadius="4dp"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sisa 12 hari lagi. Ayo selesaikan 10 Juz terakhir bersama grup!"
            android:textColor="#666666"
            android:textSize="13sp"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Daily Discussion / Tadabbur Feed Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tadabbur &amp; Diskusi Terkini"
        android:textColor="#212121"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <!-- Discussion Post Card 1 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="12dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FFEAEAEA">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Ahmad Fauzi"
              android:textColor="#212121"
              android:textSize="14sp"
              android:textStyle="bold"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="2 jam yang lalu"
              android:textColor="#999999"
              android:textSize="12sp"
              android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Masya Allah, ayat di Surah Al-Fatihah ini benar-benar mengingatkan kita tentang pentingnya petunjuk jalan yang lurus (Ihdinas-Siraatal-Mustaqiim)..."
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬 14 Diskusi"
            android:textColor="@color/accent_color"
            android:textSize="13sp"
            android:textStyle="bold"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Discussion Post Card 2 -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="1dp"
        app:cardBackgroundColor="#FFFFFF"
        android:layout_marginBottom="16dp"
        app:strokeWidth="1dp"
        app:strokeColor="#FFEAEAEA">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Sarah Nabila"
              android:textColor="#212121"
              android:textSize="14sp"
              android:textStyle="bold"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="1 hari yang lalu"
              android:textColor="#999999"
              android:textSize="12sp"
              android:layout_alignParentEnd="true"/>
        </RelativeLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Adakah teman-teman di sini yang punya jadwal rutin tadabbur 1 hari 1 halaman? Ingin join grup untuk saling menyemangati..."
            android:textColor="#333333"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💬 8 Diskusi"
            android:textColor="@color/accent_color"
            android:textSize="13sp"
            android:textStyle="bold"/>
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

  </LinearLayout>
</ScrollView>
