<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:orientation="vertical"
    android:background="#FFF9F9F9">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="@color/toolbar"
      android:theme="@style/ToolbarStyle"
      app:titleTextAppearance="@style/ToolbarTitleText" />

  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <!-- Scrollable Groups List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/btn_buat_grup_container"
        android:scrollbars="none">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <!-- Group 1 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFEAEAEA"
            app:cardBackgroundColor="#FFFFFF">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

              <TextView
                  android:id="@+id/group_name_1"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Keluarga Taqwa"
                  android:textColor="#212121"
                  android:textSize="15sp"
                  android:textStyle="bold" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="75% Selesai"
                  android:textColor="@color/accent_color"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="75"
                app:trackColor="#FFE0E0E0"
                app:indicatorColor="@color/accent_color"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 Anggota Aktif • Target Khatam: Dzulhijjah"
                android:textColor="#888888"
                android:textSize="12sp" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Group 2 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFEAEAEA"
            app:cardBackgroundColor="#FFFFFF">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

              <TextView
                  android:id="@+id/group_name_2"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Majelis Quran Jakarta"
                  android:textColor="#212121"
                  android:textSize="15sp"
                  android:textStyle="bold" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="60% Selesai"
                  android:textColor="@color/accent_color"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="60"
                app:trackColor="#FFE0E0E0"
                app:indicatorColor="@color/accent_color"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="45 Anggota Aktif • Target Khatam: Bulanan"
                android:textColor="#888888"
                android:textSize="12sp" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Group 3 Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFEAEAEA"
            app:cardBackgroundColor="#FFFFFF">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:padding="16dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp">

              <TextView
                  android:id="@+id/group_name_3"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Sahabat Fillah"
                  android:textColor="#212121"
                  android:textSize="15sp"
                  android:textStyle="bold" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="90% Selesai"
                  android:textColor="@color/accent_color"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:progress="90"
                app:trackColor="#FFE0E0E0"
                app:indicatorColor="@color/accent_color"
                app:trackThickness="6dp"
                app:trackCornerRadius="3dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="8 Anggota Aktif • Target Khatam: Mingguan"
                android:textColor="#888888"
                android:textSize="12sp" />
          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

      </LinearLayout>
    </ScrollView>

    <!-- Create Group button container stuck at bottom -->
    <LinearLayout
        android:id="@+id/btn_buat_grup_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF"
        android:elevation="8dp">

      <com.google.android.material.button.MaterialButton
          android:id="@+id/btn_buat_grup"
          android:layout_width="match_parent"
          android:layout_height="50dp"
          android:text="Buat Grup Baru"
          android:textColor="#FFFFFF"
          android:textStyle="bold"
          android:textSize="14sp"
          app:cornerRadius="25dp"
          app:backgroundTint="@color/accent_color" />
    </LinearLayout>

  </RelativeLayout>
</LinearLayout>
