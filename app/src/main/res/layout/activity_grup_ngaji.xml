<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F9F9">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="@color/toolbar"
      android:theme="@style/ToolbarStyle"
      app:titleTextAppearance="@style/ToolbarTitleText"/>

  <!-- Action Buttons (Join via Code & Create Group) -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:padding="16dp"
      android:background="#FFFFFF"
      android:elevation="2dp"
      android:gravity="center">

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_join_by_id"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:layout_marginEnd="8dp"
        android:text="Join via ID"
        android:textColor="@color/accent_color"
        app:strokeColor="@color/accent_color"
        app:cornerRadius="24dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_buat_grup"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_weight="1.2"
        android:text="Buat Grup"
        android:textColor="#FFFFFF"
        app:backgroundTint="@color/accent_color"
        app:cornerRadius="24dp"/>

  </LinearLayout>

  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <!-- Loading -->
    <ProgressBar
        android:id="@+id/progress_grup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone"/>

    <!-- Empty State -->
    <LinearLayout
        android:id="@+id/lay_empty_grup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

      <TextView
          android:id="@+id/tv_empty_title"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Belum Ada Grup Ngaji 👥"
          android:textColor="#212121"
          android:textSize="16sp"
          android:textStyle="bold"/>

      <TextView
          android:id="@+id/tv_empty_desc"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="6dp"
          android:text="Gabung atau buat grup untuk tilawah bersama!"
          android:textColor="#888888"
          android:textSize="12sp"/>
    </LinearLayout>

    <!-- RecyclerView Groups -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_grup_ngaji"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:clipToPadding="false"
        android:scrollbars="none"/>

  </RelativeLayout>
</LinearLayout>
