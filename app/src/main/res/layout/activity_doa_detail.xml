<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F9F9">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/toolbar"
        android:theme="@style/ToolbarStyle"
        app:titleTextAppearance="@style/ToolbarTitleText"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Card Utama Doa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="0dp"
                app:cardBackgroundColor="#FFFFFF"
                android:layout_marginBottom="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Judul Doa -->
                    <TextView
                        android:id="@+id/tv_detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Judul Doa Harian"
                        android:textColor="@color/accent_color"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:layout_marginBottom="24dp" />

                    <!-- Teks Arab -->
                    <TextView
                        android:id="@+id/tv_detail_arabic"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="رَبِّ زِدْنِي عِلْمًا"
                        android:textColor="#212121"
                        android:textSize="26sp"
                        android:gravity="right"
                        android:textStyle="bold"
                        android:lineSpacingMultiplier="1.6"
                        android:layout_marginBottom="20dp" />

                    <!-- Divider -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginBottom="20dp" />

                    <!-- Terjemahan Bahasa Indonesia -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Terjemahan:"
                        android:textColor="#999999"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tv_detail_translation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="&quot;Ya Tuhanku, tambahkanlah kepadaku ilmu pengetahuan.&quot;"
                        android:textColor="#333333"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.3"
                        android:layout_marginBottom="20dp"/>

                    <!-- Sumber / Rujukan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sumber:"
                        android:textColor="#999999"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tv_detail_source"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="QS. Thaha: 114"
                        android:textColor="#666666"
                        android:textSize="12sp"
                        android:textStyle="italic"
                        android:layout_marginBottom="16dp" />

                    <!-- Catatan Tambahan (Notes) -->
                    <LinearLayout
                        android:id="@+id/layout_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="#FFF9F9F9"
                        android:padding="12dp"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="💡 Petunjuk:"
                            android:textColor="#E28743"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:layout_marginBottom="4dp" />

                        <TextView
                            android:id="@+id/tv_detail_notes"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Baca 3 kali saat pagi hari."
                            android:textColor="#666666"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
