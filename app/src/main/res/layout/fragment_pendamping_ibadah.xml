<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface">

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Top Verse Card -->
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/card_verse_banner"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp"
          android:layout_marginBottom="20dp"
          app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_home_verse_gradient"
            android:padding="20dp">

          <TextView
              android:id="@+id/tv_verse_title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Al-Qamar (Ayat 17)"
              android:textColor="#FFFFFF"
              android:textSize="13sp"
              android:textStyle="bold"
              android:alpha="0.9"
              android:visibility="visible" />

          <TextView
              android:id="@+id/tv_verse_arabic"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_below="@id/tv_verse_title"
              android:layout_marginTop="10dp"
              android:layout_marginBottom="8dp"
              android:text="وَلَقَدْ يَسَّرْنَا الْقُرْآنَ لِلذِّكْرِ فَهَلْ مِنْ مُدَّكِرٍ"
              android:textColor="#FFFFFF"
              android:textSize="22sp"
              android:textStyle="bold"
              android:gravity="end" />

          <TextView
              android:id="@+id/tv_verse_translation"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_below="@id/tv_verse_arabic"
              android:layout_marginBottom="12dp"
              android:text="Dan sungguh, telah Kami mudahkan Al-Qur'an untuk pelajaran, maka adakah orang yang mau mengambil pelajaran"
              android:textColor="#FFFFFF"
              android:textSize="13sp"
              android:textStyle="italic"
              android:alpha="0.95" />

          <com.google.android.material.card.MaterialCardView
              android:id="@+id/btn_alhamdulillah"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/tv_verse_translation"
              app:cardCornerRadius="12dp"
              app:cardBackgroundColor="#8D4F00"
              app:strokeWidth="0dp"
              android:clickable="true"
              android:focusable="true"
              android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center">

              <ImageView
                  android:layout_width="16dp"
                  android:layout_height="16dp"
                  android:src="@drawable/ic_heart_outline"
                  app:tint="#FFFFFF" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Alhamdulillah"
                  android:textColor="#FFFFFF"
                  android:textSize="12sp"
                  android:textStyle="bold"
                  android:layout_marginStart="6dp" />
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>

          <!-- Live Donation Ticker Bar -->
          <com.google.android.material.card.MaterialCardView
              android:id="@+id/card_donation_ticker"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_below="@id/btn_alhamdulillah"
              android:layout_marginTop="16dp"
              app:cardCornerRadius="10dp"
              app:cardBackgroundColor="#33000000"
              app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:gravity="center_vertical">

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="🎁"
                  android:textSize="14sp"
                  android:layout_marginEnd="8dp"/>

              <TextSwitcher
                  android:id="@+id/switcher_donation_ticker"
                  android:layout_width="0dp"
                  android:layout_height="wrap_content"
                  android:layout_weight="1"/>

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="LIVE"
                  android:textColor="#FFD54F"
                  android:textSize="10sp"
                  android:textStyle="bold"
                  android:paddingStart="6dp"
                  android:paddingEnd="6dp"
                  android:paddingTop="2dp"
                  android:paddingBottom="2dp"
                  android:background="@drawable/bg_live_tag"
                  android:layout_marginStart="8dp"/>
            </LinearLayout>
          </com.google.android.material.card.MaterialCardView>

        </RelativeLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Main Features Grid -->
      <!-- Row 1 -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginBottom="16dp">

        <!-- Quran -->
        <LinearLayout
            android:id="@+id/card_quran"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

          <com.google.android.material.card.MaterialCardView
              android:layout_width="56dp"
              android:layout_height="56dp"
              app:cardCornerRadius="28dp"
              app:cardBackgroundColor="#FFFF6D00"
              app:cardElevation="2dp"
              app:strokeWidth="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_quran_book"
                app:tint="#FFFFFF" />
          </com.google.android.material.card.MaterialCardView>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Quran"
              android:textColor="@color/title_color"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="8dp"
              android:gravity="center" />
        </LinearLayout>

        <!-- Dzikir -->
        <LinearLayout
            android:id="@+id/card_dzikir"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

          <com.google.android.material.card.MaterialCardView
              android:layout_width="56dp"
              android:layout_height="56dp"
              app:cardCornerRadius="28dp"
              app:cardBackgroundColor="#FFFF6D00"
              app:cardElevation="2dp"
              app:strokeWidth="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hands_pray"
                app:tint="#FFFFFF" />
          </com.google.android.material.card.MaterialCardView>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Dzikir"
              android:textColor="@color/title_color"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="8dp"
              android:gravity="center" />
        </LinearLayout>

        <!-- Arah Kiblat -->
        <LinearLayout
            android:id="@+id/card_kiblat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

          <com.google.android.material.card.MaterialCardView
              android:layout_width="56dp"
              android:layout_height="56dp"
              app:cardCornerRadius="28dp"
              app:cardBackgroundColor="#FFFF6D00"
              app:cardElevation="2dp"
              app:strokeWidth="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_kiblat_grid"
                app:tint="#FFFFFF" />
          </com.google.android.material.card.MaterialCardView>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Arah Kiblat"
              android:textColor="@color/title_color"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="8dp"
              android:gravity="center" />
        </LinearLayout>

        <!-- Khatam Tracker -->
        <LinearLayout
            android:id="@+id/card_khatam"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

          <com.google.android.material.card.MaterialCardView
              android:layout_width="56dp"
              android:layout_height="56dp"
              app:cardCornerRadius="28dp"
              app:cardBackgroundColor="#FFFF6D00"
              app:cardElevation="2dp"
              app:strokeWidth="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_medal"
                app:tint="#FFFFFF" />
          </com.google.android.material.card.MaterialCardView>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Khatam Tracker"
              android:textColor="@color/title_color"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="8dp"
              android:gravity="center" />
        </LinearLayout>
      </LinearLayout>

      <!-- Row 2 -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:layout_marginBottom="24dp">

        <!-- Zakat -->
        <LinearLayout
            android:id="@+id/card_zakat"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

          <com.google.android.material.card.MaterialCardView
              android:layout_width="56dp"
              android:layout_height="56dp"
              app:cardCornerRadius="28dp"
              app:cardBackgroundColor="#FFFF6D00"
              app:cardElevation="2dp"
              app:strokeWidth="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_zakat"
                app:tint="#FFFFFF" />
          </com.google.android.material.card.MaterialCardView>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Zakat"
              android:textColor="@color/title_color"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="8dp"
              android:gravity="center" />
        </LinearLayout>

        <!-- Catatan Ibadah -->
        <LinearLayout
            android:id="@+id/card_catatan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

          <com.google.android.material.card.MaterialCardView
              android:layout_width="56dp"
              android:layout_height="56dp"
              app:cardCornerRadius="28dp"
              app:cardBackgroundColor="#FFFF6D00"
              app:cardElevation="2dp"
              app:strokeWidth="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_notes"
                app:tint="#FFFFFF" />
          </com.google.android.material.card.MaterialCardView>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Catatan Ibadah"
              android:textColor="@color/title_color"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="8dp"
              android:gravity="center" />
        </LinearLayout>

        <!-- Kalender -->
        <LinearLayout
            android:id="@+id/card_kalender"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

          <com.google.android.material.card.MaterialCardView
              android:layout_width="56dp"
              android:layout_height="56dp"
              app:cardCornerRadius="28dp"
              app:cardBackgroundColor="#FFFF6D00"
              app:cardElevation="2dp"
              app:strokeWidth="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_event"
                app:tint="#FFFFFF" />
          </com.google.android.material.card.MaterialCardView>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Kalender"
              android:textColor="@color/title_color"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="8dp"
              android:gravity="center" />
        </LinearLayout>

        <!-- Pejuang Kebaikan -->
        <LinearLayout
            android:id="@+id/card_pejuang_kebaikan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

          <com.google.android.material.card.MaterialCardView
              android:layout_width="56dp"
              android:layout_height="56dp"
              app:cardCornerRadius="28dp"
              app:cardBackgroundColor="#FFFF6D00"
              app:cardElevation="2dp"
              app:strokeWidth="0dp">
            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_strava_quran"
                app:tint="#FFFFFF" />
          </com.google.android.material.card.MaterialCardView>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Pejuang Kebaikan"
              android:textColor="@color/title_color"
              android:textSize="11sp"
              android:textStyle="bold"
              android:layout_marginTop="8dp"
              android:gravity="center" />
        </LinearLayout>
      </LinearLayout>

      <!-- Campaigns Banners (Dynamic from Database) -->
      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:layout_marginBottom="24dp">

        <!-- Section Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="💝 Campaign Donasi"
              android:textColor="@color/title_color"
              android:textSize="14sp"
              android:textStyle="bold"
              android:layout_centerVertical="true"/>

          <!-- Tombol Tambah Campaign (Admin Only) -->
          <TextView
              android:id="@+id/btn_add_campaign"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="+ Tambah"
              android:textColor="@color/accent_color"
              android:textSize="12sp"
              android:textStyle="bold"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:visibility="gone"/>
        </RelativeLayout>

        <!-- Dynamic Campaign RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_campaigns"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:orientation="horizontal"
            android:scrollbars="none"
            android:clipToPadding="false"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"/>

        <!-- Placeholder ketika tidak ada campaign -->
        <TextView
            android:id="@+id/tv_no_campaign"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum ada campaign saat ini"
            android:textColor="@color/text_hint_color"
            android:textSize="12sp"
            android:gravity="center"
            android:padding="16dp"
            android:visibility="gone"/>
      </LinearLayout>

      <!-- Prayer Times Card (Horizontal layout) -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="16dp"
          app:cardElevation="1dp"
          app:cardBackgroundColor="@color/secondary_dark_background"
          android:layout_marginBottom="24dp"
          app:strokeWidth="1dp"
          app:strokeColor="#FFEAEAEA">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

          <!-- Header -->
          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

              <ImageView
                  android:layout_width="18dp"
                  android:layout_height="18dp"
                  android:src="@drawable/ic_time"
                  app:tint="@color/accent_color" />

              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Prayer Times"
                  android:textColor="@color/title_color"
                  android:textSize="15sp"
                  android:textStyle="bold"
                  android:layout_marginStart="6dp" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_select_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="📍 Jakarta"
                android:textColor="@color/text_hint_color"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />
          </RelativeLayout>

          <!-- Times list (Horizontal) -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="center_vertical">

            <!-- Subuh -->
            <LinearLayout
                android:id="@+id/col_subuh"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

              <TextView
                  android:id="@+id/label_subuh"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="FAJR"
                  android:textColor="@color/text_hint_color"
                  android:textSize="11sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/tv_subuh"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="04:12"
                  android:textColor="@color/title_color"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Dzuhur -->
            <LinearLayout
                android:id="@+id/col_dzuhur"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

              <TextView
                  android:id="@+id/label_dzuhur"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="DHUHR"
                  android:textColor="@color/text_hint_color"
                  android:textSize="11sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/tv_dzuhur"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="13:05"
                  android:textColor="@color/title_color"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Ashar -->
            <LinearLayout
                android:id="@+id/col_ashar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

              <TextView
                  android:id="@+id/label_ashar"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="ASR"
                  android:textColor="@color/text_hint_color"
                  android:textSize="11sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/tv_ashar"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="16:54"
                  android:textColor="@color/title_color"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Maghrib -->
            <LinearLayout
                android:id="@+id/col_maghrib"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

              <TextView
                  android:id="@+id/label_maghrib"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="MAGHRIB"
                  android:textColor="@color/text_hint_color"
                  android:textSize="11sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/tv_maghrib"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="20:22"
                  android:textColor="@color/title_color"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- Isya -->
            <LinearLayout
                android:id="@+id/col_isya"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="8dp"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp">

              <TextView
                  android:id="@+id/label_isya"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="ISHA"
                  android:textColor="@color/text_hint_color"
                  android:textSize="11sp"
                  android:textStyle="bold" />

              <TextView
                  android:id="@+id/tv_isya"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="21:45"
                  android:textColor="@color/title_color"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_marginTop="4dp" />
            </LinearLayout>

          </LinearLayout>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Bottom Quote Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          app:cardCornerRadius="16dp"
          app:cardElevation="0dp"
          app:cardBackgroundColor="@color/secondary_dark_background"
          app:strokeWidth="0dp"
          android:layout_marginBottom="60dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

          <ImageView
              android:layout_width="28dp"
              android:layout_height="28dp"
              android:src="@drawable/ic_lightbulb"
              app:tint="@color/accent_color"
              android:layout_marginBottom="12dp" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="&quot;Maka bacalah apa yang mudah bagimu dari Al-Qur'an.&quot;"
              android:textColor="@color/title_color"
              android:textSize="14sp"
              android:gravity="center"
              android:layout_marginBottom="8dp" />

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="(QS. Al-Muzzammil: 20)"
              android:textColor="@color/accent_color"
              android:textSize="12sp"
              android:textStyle="bold"
              android:gravity="center" />
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- Hidden views for legacy functionality/compilation -->
      <com.google.android.material.switchmaterial.SwitchMaterial
          android:id="@+id/switch_adhan"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:visibility="gone" />
      <TextView
          android:id="@+id/tv_adhan_status"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:visibility="gone" />

    </LinearLayout>
  </ScrollView>

  <!-- Floating Action Button -->
  <com.google.android.material.floatingactionbutton.FloatingActionButton
      android:id="@+id/fab_last_page"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_alignParentEnd="true"
      android:layout_alignParentBottom="true"
      android:layout_margin="16dp"
      app:srcCompat="@drawable/ic_quran_book"
      app:tint="#FFFFFF"
      app:backgroundTint="#8D4F00"
      app:elevation="6dp" />

</RelativeLayout>
