<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF9F9F9">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="#FFFFFF"
      app:title="Pejuang Quran"
      app:titleTextColor="@color/accent_color"
      app:navigationIcon="?attr/homeAsUpIndicator"
      app:elevation="2dp" />

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Header Quote Card -->
      <com.google.android.material.card.MaterialCardView
          android:layout_width="match_parent"
          android:layout_height="180dp"
          android:layout_marginBottom="24dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp"
          app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

          <!-- Background Image -->
          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:src="@drawable/bg_home_verse_card"
              android:scaleType="centerCrop" />

          <!-- Dark Overlay / Scrim -->
          <View
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="#95000000" />

          <!-- Decorative geometric patterns in code or text -->
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="✨"
              android:textSize="40sp"
              android:layout_alignParentEnd="true"
              android:layout_margin="16dp"
              android:alpha="0.2"/>

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:gravity="center"
              android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="“Siapa yang menunjukkan kepada kebaikan, maka ia mendapat pahala seperti orang yang melakukannya.”"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="italic|bold"
                android:gravity="center"
                android:shadowColor="#40000000"
                android:shadowDx="1"
                android:shadowDy="1"
                android:shadowRadius="2"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="— HR. Muslim —"
                android:textColor="#E0F2F1"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp"/>

          </LinearLayout>
        </RelativeLayout>
      </com.google.android.material.card.MaterialCardView>

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Kategori Kemitraan"
          android:textColor="#212121"
          android:textSize="16sp"
          android:textStyle="bold"
          android:layout_marginBottom="4dp" />

      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Pilih kategori kemitraan di bawah ini untuk melihat lembaga yang ikut andil mendukung program Al-Quran."
          android:textColor="#888888"
          android:textSize="11sp"
          android:layout_marginBottom="16dp" />

      <!-- 1. Mitra Utama -->
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/btn_mitra_utama"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardCornerRadius="14dp"
          app:cardElevation="1dp"
          app:strokeWidth="1dp"
          app:strokeColor="#FFEAEAEA"
          app:cardBackgroundColor="#FFFFFF"
          android:clickable="true"
          android:focusable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="🤝"
              android:textSize="28sp" />
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mitra Utama"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lembaga penyokong utama program Quran"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
          </LinearLayout>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="@color/accent_color"
              android:textSize="24sp"
              android:textStyle="bold"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- 2. Pendukung Resmi -->
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/btn_pendukung_resmi"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardCornerRadius="14dp"
          app:cardElevation="1dp"
          app:strokeWidth="1dp"
          app:strokeColor="#FFEAEAEA"
          app:cardBackgroundColor="#FFFFFF"
          android:clickable="true"
          android:focusable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="💎"
              android:textSize="28sp" />
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pendukung Resmi"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Instansi yang menyokong sarana &amp; operasional"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
          </LinearLayout>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="@color/accent_color"
              android:textSize="24sp"
              android:textStyle="bold"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- 3. Mitra Distribusi -->
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/btn_mitra_distribusi"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="12dp"
          app:cardCornerRadius="14dp"
          app:cardElevation="1dp"
          app:strokeWidth="1dp"
          app:strokeColor="#FFEAEAEA"
          app:cardBackgroundColor="#FFFFFF"
          android:clickable="true"
          android:focusable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="🕌"
              android:textSize="28sp" />
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mitra Distribusi"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Masjid &amp; lembaga penyalur mushaf Al-Quran"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
          </LinearLayout>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="@color/accent_color"
              android:textSize="24sp"
              android:textStyle="bold"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

      <!-- 4. Mitra Edukasi -->
      <com.google.android.material.card.MaterialCardView
          android:id="@+id/btn_mitra_edukasi"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="24dp"
          app:cardCornerRadius="14dp"
          app:cardElevation="1dp"
          app:strokeWidth="1dp"
          app:strokeColor="#FFEAEAEA"
          app:cardBackgroundColor="#FFFFFF"
          android:clickable="true"
          android:focusable="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="📚"
              android:textSize="28sp" />
          <LinearLayout
              android:layout_width="0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1"
              android:orientation="vertical"
              android:layout_marginStart="16dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mitra Edukasi"
                android:textColor="#212121"
                android:textSize="14sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pesantren &amp; komunitas pembina kajian Quran"
                android:textColor="#888888"
                android:textSize="11sp"
                android:layout_marginTop="2dp" />
          </LinearLayout>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="›"
              android:textColor="@color/accent_color"
              android:textSize="24sp"
              android:textStyle="bold"/>
        </LinearLayout>
      </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
  </ScrollView>
</LinearLayout>
