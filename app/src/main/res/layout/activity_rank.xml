<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:orientation="vertical"
    android:background="#FFF9F9F9">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="@color/toolbar"
      android:theme="@style/ToolbarStyle"
      app:titleTextAppearance="@style/ToolbarTitleText"/>

  <!-- Toggle Mingguan / Bulanan -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal"
      android:background="#FFFFFF"
      android:padding="12dp"
      android:gravity="center"
      android:elevation="2dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:background="@drawable/bg_segmented_control"
        android:padding="3dp">

      <TextView
          android:id="@+id/txt_toggle_mingguan"
          android:layout_width="110dp"
          android:layout_height="match_parent"
          android:text="📅 Mingguan"
          android:gravity="center"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="#FFFFFF"
          android:background="@drawable/bg_segmented_selected"/>

      <TextView
          android:id="@+id/txt_toggle_bulanan"
          android:layout_width="110dp"
          android:layout_height="match_parent"
          android:text="🗓️ Bulanan"
          android:gravity="center"
          android:textSize="12sp"
          android:textStyle="bold"
          android:textColor="#666666"/>

    </LinearLayout>
  </LinearLayout>

  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <!-- List Rank -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/card_user_rank"
        android:scrollbars="none">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <!-- Loading -->
        <ProgressBar
            android:id="@+id/progress_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone"/>

        <!-- Empty -->
        <TextView
            android:id="@+id/txt_rank_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="40dp"
            android:text="Belum ada data peringkat"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:visibility="gone"/>

        <!-- RecyclerView dalam card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_leaderboard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFEAEAEA"
            app:cardBackgroundColor="#FFFFFF"
            android:visibility="gone">

          <androidx.recyclerview.widget.RecyclerView
              android:id="@+id/rv_rank"
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:nestedScrollingEnabled="false"/>

        </com.google.android.material.card.MaterialCardView>

      </LinearLayout>
    </ScrollView>

    <!-- Card Rank User Sendiri (sticky bottom) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_user_rank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp"
        android:visibility="gone">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:background="@drawable/bg_card_doa"
          android:padding="16dp"
          android:gravity="center_vertical">

        <TextView
            android:id="@+id/tv_my_rank"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="#-"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"/>

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_solid"
            android:backgroundTint="#783A06">
          <TextView
              android:id="@+id/tv_my_initials"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="ME"
              android:textColor="#FFFFFF"
              android:textSize="12sp"
              android:textStyle="bold"
              android:layout_gravity="center"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
          <TextView
              android:id="@+id/tv_my_name"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Nama Anda"
              android:textColor="#FFFFFF"
              android:textSize="13sp"
              android:textStyle="bold"/>
          <TextView
              android:id="@+id/tv_my_stat"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Terus tingkatkan tilawah!"
              android:textColor="#FFEBE0"
              android:textSize="11sp"
              android:layout_marginTop="2dp"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">
          <TextView
              android:id="@+id/tv_my_score"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="0"
              android:textColor="#FFFFFF"
              android:textSize="14sp"
              android:textStyle="bold"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="menit"
              android:textColor="#FFEBE0"
              android:textSize="9sp"/>
        </LinearLayout>

      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

  </RelativeLayout>
</LinearLayout>
