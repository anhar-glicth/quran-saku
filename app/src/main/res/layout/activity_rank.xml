<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/root"
    android:orientation="vertical"
    android:background="#FFF9F9F9">

  <androidx.appcompat.widget.Toolbar
      android:id="@+id/toolbar"
      android:layout_width="match_parent"
      android:layout_height="?attr/actionBarSize"
      android:background="@color/toolbar"
      android:theme="@style/ToolbarStyle"
      app:titleTextAppearance="@style/ToolbarTitleText" />

  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent">

    <!-- Scrollable Rankings List -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/card_user_rank"
        android:scrollbars="none">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="vertical"
          android:padding="16dp">

        <!-- Leaderboard Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="14dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFEAEAEA"
            app:cardBackgroundColor="#FFFFFF">

          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="vertical"
              android:paddingHorizontal="16dp"
              android:paddingVertical="8dp">

            <!-- Leader 1 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp">

              <TextView
                  android:id="@+id/rank_1"
                  android:layout_width="24dp"
                  android:layout_height="wrap_content"
                  android:text="🥇"
                  android:textSize="18sp"
                  android:layout_centerVertical="true" />

              <FrameLayout
                  android:id="@+id/avatar_1"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:layout_toEndOf="@id/rank_1"
                  android:layout_marginStart="8dp"
                  android:background="@drawable/bg_circle_solid"
                  android:backgroundTint="#FFF3E0"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FA"
                    android:textColor="#E65100"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
              </FrameLayout>

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:layout_toEndOf="@id/avatar_1"
                  android:layout_toStartOf="@id/progress_container_1"
                  android:layout_marginStart="12dp"
                  android:layout_marginEnd="12dp"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fatimah Az-Zahra"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktif 5 menit yang lalu"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
              </LinearLayout>

              <LinearLayout
                  android:id="@+id/progress_container_1"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:gravity="end"
                  android:layout_alignParentEnd="true"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5.120"
                    android:textColor="@color/accent_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AYAH"
                    android:textColor="#888888"
                    android:textSize="8sp"
                    android:layout_marginTop="1dp" />
              </LinearLayout>
            </RelativeLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFEAEAEA" />

            <!-- Leader 2 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp">

              <TextView
                  android:id="@+id/rank_2"
                  android:layout_width="24dp"
                  android:layout_height="wrap_content"
                  android:text="🥈"
                  android:textSize="18sp"
                  android:layout_centerVertical="true" />

              <FrameLayout
                  android:id="@+id/avatar_2"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:layout_toEndOf="@id/rank_2"
                  android:layout_marginStart="8dp"
                  android:background="@drawable/bg_circle_solid"
                  android:backgroundTint="#ECEFF1"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AF"
                    android:textColor="#455A64"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
              </FrameLayout>

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:layout_toEndOf="@id/avatar_2"
                  android:layout_toStartOf="@id/progress_container_2"
                  android:layout_marginStart="12dp"
                  android:layout_marginEnd="12dp"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ahmad Farhan"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktif 1 jam yang lalu"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
              </LinearLayout>

              <LinearLayout
                  android:id="@+id/progress_container_2"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:gravity="end"
                  android:layout_alignParentEnd="true"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.950"
                    android:textColor="@color/accent_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AYAH"
                    android:textColor="#888888"
                    android:textSize="8sp"
                    android:layout_marginTop="1dp" />
              </LinearLayout>
            </RelativeLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFEAEAEA" />

            <!-- Leader 3 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp">

              <TextView
                  android:id="@+id/rank_3"
                  android:layout_width="24dp"
                  android:layout_height="wrap_content"
                  android:text="🥉"
                  android:textSize="18sp"
                  android:layout_centerVertical="true" />

              <FrameLayout
                  android:id="@+id/avatar_3"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:layout_toEndOf="@id/rank_3"
                  android:layout_marginStart="8dp"
                  android:background="@drawable/bg_circle_solid"
                  android:backgroundTint="#EFEBE9"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SN"
                    android:textColor="#5D4037"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
              </FrameLayout>

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:layout_toEndOf="@id/avatar_3"
                  android:layout_toStartOf="@id/progress_container_3"
                  android:layout_marginStart="12dp"
                  android:layout_marginEnd="12dp"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sarah Nabila"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktif 3 jam yang lalu"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
              </LinearLayout>

              <LinearLayout
                  android:id="@+id/progress_container_3"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:gravity="end"
                  android:layout_alignParentEnd="true"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.200"
                    android:textColor="@color/accent_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AYAH"
                    android:textColor="#888888"
                    android:textSize="8sp"
                    android:layout_marginTop="1dp" />
              </LinearLayout>
            </RelativeLayout>

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#FFEAEAEA" />

            <!-- Leader 4 -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="12dp">

              <TextView
                  android:id="@+id/rank_4"
                  android:layout_width="24dp"
                  android:layout_height="wrap_content"
                  android:text=" 4 "
                  android:textColor="#888888"
                  android:textSize="14sp"
                  android:textStyle="bold"
                  android:layout_centerVertical="true" />

              <FrameLayout
                  android:id="@+id/avatar_4"
                  android:layout_width="40dp"
                  android:layout_height="40dp"
                  android:layout_toEndOf="@id/rank_4"
                  android:layout_marginStart="8dp"
                  android:background="@drawable/bg_circle_solid"
                  android:backgroundTint="#E1F5FE"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YI"
                    android:textColor="#0288D1"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_gravity="center" />
              </FrameLayout>

              <LinearLayout
                  android:layout_width="match_parent"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:layout_toEndOf="@id/avatar_4"
                  android:layout_toStartOf="@id/progress_container_4"
                  android:layout_marginStart="12dp"
                  android:layout_marginEnd="12dp"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Yusuf Ibrahim"
                    android:textColor="#212121"
                    android:textSize="13sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aktif 1 hari yang lalu"
                    android:textColor="#888888"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
              </LinearLayout>

              <LinearLayout
                  android:id="@+id/progress_container_4"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:orientation="vertical"
                  android:gravity="end"
                  android:layout_alignParentEnd="true"
                  android:layout_centerVertical="true">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3.850"
                    android:textColor="@color/accent_color"
                    android:textSize="15sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AYAH"
                    android:textColor="#888888"
                    android:textSize="8sp"
                    android:layout_marginTop="1dp" />
              </LinearLayout>
            </RelativeLayout>

          </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
      </LinearLayout>
    </ScrollView>

    <!-- Stuck User Rank Card at the Bottom -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_user_rank"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

      <LinearLayout
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:orientation="horizontal"
          android:background="@drawable/bg_card_doa"
          android:padding="16dp"
          android:gravity="center_vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="14"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginEnd="16dp" />

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_circle_solid"
            android:backgroundTint="#783A06">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="ME"
              android:textColor="#FFFFFF"
              android:textSize="12sp"
              android:textStyle="bold"
              android:layout_gravity="center" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Peringkat Anda"
              android:textColor="#FFFFFF"
              android:textSize="13sp"
              android:textStyle="bold" />
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Terus tingkatkan tilawah Anda!"
              android:textColor="#FFEBE0"
              android:textSize="11sp"
              android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.200 Ayah"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
      </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

  </RelativeLayout>
</LinearLayout>
