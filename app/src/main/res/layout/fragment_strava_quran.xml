<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F4"
    android:clickable="true"
    android:focusable="true">

  <!-- Header -->
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="#FFFFFF"
      android:elevation="2dp"
      android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@android:drawable/ic_menu_revert"
        android:rotation="180"
        android:tint="#FF6D00"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Strava Al-Qur'an"
        android:textColor="#FF6D00"
        android:textSize="18sp"
        android:textStyle="bold"/>
  </RelativeLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Streak & Target Status Card -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/quran_header_bg"
            android:padding="16dp">

          <TextView
              android:id="@+id/lbl_streak"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Konsistensi Tilawah"
              android:textColor="#FFFDE7"
              android:textSize="12sp"
              android:alpha="0.9"/>

          <TextView
              android:id="@+id/txt_streak_title"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/lbl_streak"
              android:layout_marginTop="4dp"
              android:text="🔥 7 Hari Beruntun!"
              android:textColor="#FFFFFF"
              android:textSize="22sp"
              android:textStyle="bold"/>

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/txt_streak_title"
              android:text="Target: 15 menit per hari"
              android:textColor="#FFFDE7"
              android:textSize="12sp"
              android:alpha="0.8"/>

          <Button
              android:id="@+id/btn_share_streak"
              android:layout_width="wrap_content"
              android:layout_height="36dp"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:text="Bagikan"
              android:textColor="#FF6D00"
              android:textSize="12sp"
              android:backgroundTint="#FFFFFF"
              android:paddingHorizontal="16dp"
              style="@style/Widget.MaterialComponents.Button"
              app:cornerRadius="18dp"/>

        </RelativeLayout>
      </androidx.cardview.widget.CardView>

      <!-- Weekly Progress Statistics -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:text="Durasi Membaca Minggu Ini"
              android:textColor="#333333"
              android:textSize="14sp"
              android:textStyle="bold"
              android:layout_marginBottom="12dp"/>

          <!-- Weekly Chart Bars (Simulated using progress bars or small heights) -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:orientation="horizontal"
              android:gravity="bottom"
              android:paddingBottom="8dp">

            <!-- Mon -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
              <View
                  android:layout_width="12dp"
                  android:layout_height="60dp"
                  android:background="#FF6D00"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="S"
                  android:textColor="#666666"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Tue -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
              <View
                  android:layout_width="12dp"
                  android:layout_height="80dp"
                  android:background="#FF6D00"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="S"
                  android:textColor="#666666"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Wed -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
              <View
                  android:layout_width="12dp"
                  android:layout_height="40dp"
                  android:background="#FF6D00"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="R"
                  android:textColor="#666666"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Thu -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
              <View
                  android:layout_width="12dp"
                  android:layout_height="90dp"
                  android:background="#FF6D00"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="K"
                  android:textColor="#666666"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Fri -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
              <View
                  android:layout_width="12dp"
                  android:layout_height="50dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="J"
                  android:textColor="#666666"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Sat -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
              <View
                  android:layout_width="12dp"
                  android:layout_height="20dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="S"
                  android:textColor="#666666"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Sun -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">
              <View
                  android:layout_width="12dp"
                  android:layout_height="70dp"
                  android:background="#FF6D00"/>
              <TextView
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="4dp"
                  android:text="M"
                  android:textColor="#666666"
                  android:textSize="10sp"/>
            </LinearLayout>

          </LinearLayout>

        </LinearLayout>
      </androidx.cardview.widget.CardView>

      <!-- Leaderboard Header -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Leaderboard Mingguan"
          android:textColor="#333333"
          android:textSize="16sp"
          android:textStyle="bold"
          android:layout_marginBottom="12dp"/>

      <!-- Rank 1 -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFFFFF">
          <TextView
              android:id="@+id/txt_rank_1"
              android:layout_width="24dp"
              android:layout_height="wrap_content"
              android:text="🥇"
              android:textSize="16sp"
              android:layout_centerVertical="true"/>
          <TextView
              android:id="@+id/name_rank_1"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_toEndOf="@id/txt_rank_1"
              android:layout_marginStart="8dp"
              android:text="Ahmad Fauzi"
              android:textColor="#333333"
              android:textStyle="bold"
              android:textSize="14sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/name_rank_1"
              android:layout_toEndOf="@id/txt_rank_1"
              android:layout_marginStart="8dp"
              android:text="Level 5 • 8.3 km (halaman)"
              android:textColor="#888888"
              android:textSize="11sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:text="45 Menit"
              android:textColor="#FF6D00"
              android:textStyle="bold"
              android:textSize="14sp"/>
        </RelativeLayout>
      </androidx.cardview.widget.CardView>

      <!-- Rank 2 -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFFFFF">
          <TextView
              android:id="@+id/txt_rank_2"
              android:layout_width="24dp"
              android:layout_height="wrap_content"
              android:text="🥈"
              android:textSize="16sp"
              android:layout_centerVertical="true"/>
          <TextView
              android:id="@+id/name_rank_2"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_toEndOf="@id/txt_rank_2"
              android:layout_marginStart="8dp"
              android:text="Yusuf Amin"
              android:textColor="#333333"
              android:textStyle="bold"
              android:textSize="14sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/name_rank_2"
              android:layout_toEndOf="@id/txt_rank_2"
              android:layout_marginStart="8dp"
              android:text="Level 3 • 4.5 km (halaman)"
              android:textColor="#888888"
              android:textSize="11sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:text="30 Menit"
              android:textColor="#FF6D00"
              android:textStyle="bold"
              android:textSize="14sp"/>
        </RelativeLayout>
      </androidx.cardview.widget.CardView>

      <!-- Rank 3 (Me) -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFF3E0"> <!-- Light orange for highlight -->
          <TextView
              android:id="@+id/txt_rank_3"
              android:layout_width="24dp"
              android:layout_height="wrap_content"
              android:text="🥉"
              android:textSize="16sp"
              android:layout_centerVertical="true"/>
          <TextView
              android:id="@+id/name_rank_3"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_toEndOf="@id/txt_rank_3"
              android:layout_marginStart="8dp"
              android:text="Saya (Anda)"
              android:textColor="#333333"
              android:textStyle="bold"
              android:textSize="14sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/name_rank_3"
              android:layout_toEndOf="@id/txt_rank_3"
              android:layout_marginStart="8dp"
              android:text="Level 2 • 2.0 km (halaman)"
              android:textColor="#888888"
              android:textSize="11sp"/>
          <TextView
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:text="15 Menit"
              android:textColor="#FF6D00"
              android:textStyle="bold"
              android:textSize="14sp"/>
        </RelativeLayout>
      </androidx.cardview.widget.CardView>

    </LinearLayout>
  </ScrollView>
</LinearLayout>
