<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFF8F4"
    android:clickable="true"
    android:focusable="true">

  <!-- Header -->
  <RelativeLayout
      android:layout_width="match_parent"
      android:layout_height="56dp"
      android:background="#FFFFFF"
      android:elevation="2dp"
      android:paddingHorizontal="16dp">

    <ImageView
        android:id="@+id/btn_back"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:src="@android:drawable/ic_menu_revert"
        android:rotation="180"
        android:tint="#FF6D00"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="Strava Al-Qur'an"
        android:textColor="#FF6D00"
        android:textSize="18sp"
        android:textStyle="bold"/>
  </RelativeLayout>

  <ScrollView
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

      <!-- Streak & Target Status Card -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="110dp"
          android:layout_marginBottom="16dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

          <!-- Background Image -->
          <ImageView
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:src="@drawable/quran_header_bg"
              android:scaleType="centerCrop" />

          <!-- Dark Overlay / Scrim -->
          <View
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:background="#80000000" />

          <!-- Content container -->
          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:padding="16dp">

            <TextView
                android:id="@+id/lbl_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Konsistensi Tilawah"
                android:textColor="#FFFDE7"
                android:textSize="12sp"
                android:alpha="0.9"/>

            <TextView
                android:id="@+id/txt_streak_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/lbl_streak"
                android:layout_marginTop="2dp"
                android:text="🔥 7 Hari Beruntun!"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/txt_streak_title"
                android:text="Target: 15 menit per hari"
                android:textColor="#FFFDE7"
                android:textSize="12sp"
                android:alpha="0.8"/>

            <Button
                android:id="@+id/btn_share_streak"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:text="Bagikan"
                android:textColor="#FF6D00"
                android:textSize="11sp"
                android:backgroundTint="#FFFFFF"
                android:paddingHorizontal="12dp"
                style="@style/Widget.MaterialComponents.Button"
                app:cornerRadius="16dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"/>
          </RelativeLayout>
        </RelativeLayout>
      </androidx.cardview.widget.CardView>

      <!-- Weekly Progress Statistics -->
      <androidx.cardview.widget.CardView
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="16dp"
          app:cardCornerRadius="16dp"
          app:cardElevation="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#FFFFFF">

          <RelativeLayout
              android:layout_width="match_parent"
              android:layout_height="wrap_content"
              android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/tv_chart_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Statistik Mengaji Mingguan"
                android:textColor="#333333"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_centerVertical="true"/>

            <!-- Toggle Buttons -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_alignParentEnd="true"
                android:background="#F5F5F5"
                android:padding="2dp">

              <TextView
                  android:id="@+id/btn_mode_duration"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Durasi"
                  android:textSize="11sp"
                  android:textStyle="bold"
                  android:textColor="#FFFFFF"
                  android:background="#FF6D00"
                  android:paddingHorizontal="10dp"
                  android:paddingVertical="4dp"
                  android:clickable="true"
                  android:focusable="true"/>

              <TextView
                  android:id="@+id/btn_mode_pages"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="Halaman"
                  android:textSize="11sp"
                  android:textStyle="bold"
                  android:textColor="#666666"
                  android:background="#00000000"
                  android:paddingHorizontal="10dp"
                  android:paddingVertical="4dp"
                  android:clickable="true"
                  android:focusable="true"/>
            </LinearLayout>
          </RelativeLayout>

          <!-- Weekly Chart Bars (Simulated using dynamic heights) -->
          <LinearLayout
              android:layout_width="match_parent"
              android:layout_height="140dp"
              android:orientation="horizontal"
              android:gravity="bottom"
              android:paddingBottom="4dp">

            <!-- Day 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal">
              <TextView
                  android:id="@+id/txt_val_1"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="0m"
                  android:textColor="#666666"
                  android:textSize="9sp"
                  android:layout_marginBottom="4dp"/>
              <View
                  android:id="@+id/bar_day_1"
                  android:layout_width="14dp"
                  android:layout_height="10dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:id="@+id/txt_lbl_1"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:text="Sen"
                  android:textColor="#999999"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Day 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal">
              <TextView
                  android:id="@+id/txt_val_2"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="0m"
                  android:textColor="#666666"
                  android:textSize="9sp"
                  android:layout_marginBottom="4dp"/>
              <View
                  android:id="@+id/bar_day_2"
                  android:layout_width="14dp"
                  android:layout_height="10dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:id="@+id/txt_lbl_2"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:text="Sel"
                  android:textColor="#999999"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Day 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal">
              <TextView
                  android:id="@+id/txt_val_3"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="0m"
                  android:textColor="#666666"
                  android:textSize="9sp"
                  android:layout_marginBottom="4dp"/>
              <View
                  android:id="@+id/bar_day_3"
                  android:layout_width="14dp"
                  android:layout_height="10dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:id="@+id/txt_lbl_3"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:text="Rab"
                  android:textColor="#999999"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Day 4 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal">
              <TextView
                  android:id="@+id/txt_val_4"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="0m"
                  android:textColor="#666666"
                  android:textSize="9sp"
                  android:layout_marginBottom="4dp"/>
              <View
                  android:id="@+id/bar_day_4"
                  android:layout_width="14dp"
                  android:layout_height="10dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:id="@+id/txt_lbl_4"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:text="Kam"
                  android:textColor="#999999"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Day 5 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal">
              <TextView
                  android:id="@+id/txt_val_5"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="0m"
                  android:textColor="#666666"
                  android:textSize="9sp"
                  android:layout_marginBottom="4dp"/>
              <View
                  android:id="@+id/bar_day_5"
                  android:layout_width="14dp"
                  android:layout_height="10dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:id="@+id/txt_lbl_5"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:text="Jum"
                  android:textColor="#999999"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Day 6 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal">
              <TextView
                  android:id="@+id/txt_val_6"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="0m"
                  android:textColor="#666666"
                  android:textSize="9sp"
                  android:layout_marginBottom="4dp"/>
              <View
                  android:id="@+id/bar_day_6"
                  android:layout_width="14dp"
                  android:layout_height="10dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:id="@+id/txt_lbl_6"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:text="Sab"
                  android:textColor="#999999"
                  android:textSize="10sp"/>
            </LinearLayout>

            <!-- Day 7 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="bottom|center_horizontal">
              <TextView
                  android:id="@+id/txt_val_7"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="0m"
                  android:textColor="#666666"
                  android:textSize="9sp"
                  android:layout_marginBottom="4dp"/>
              <View
                  android:id="@+id/bar_day_7"
                  android:layout_width="14dp"
                  android:layout_height="10dp"
                  android:background="#FF8F00"/>
              <TextView
                  android:id="@+id/txt_lbl_7"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="6dp"
                  android:text="Min"
                  android:textColor="#999999"
                  android:textSize="10sp"/>
            </LinearLayout>

          </LinearLayout>

        </LinearLayout>
      </androidx.cardview.widget.CardView>


      <!-- Leaderboard Header -->
      <TextView
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="Leaderboard Mingguan"
          android:textColor="#333333"
          android:textSize="16sp"
          android:textStyle="bold"
          android:layout_marginBottom="12dp"/>

      <!-- Rank 1 -->
      <!-- Rank 1 -->
      <androidx.cardview.widget.CardView
          android:id="@+id/card_rank_1"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp">
        <RelativeLayout
            android:id="@+id/bg_rank_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFFFFF">
          <TextView
              android:id="@+id/txt_rank_1"
              android:layout_width="24dp"
              android:layout_height="wrap_content"
              android:text="🥇"
              android:textSize="16sp"
              android:layout_centerVertical="true"/>
          <TextView
              android:id="@+id/name_rank_1"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_toEndOf="@id/txt_rank_1"
              android:layout_marginStart="8dp"
              android:text="Ahmad Fauzi"
              android:textColor="#333333"
              android:textStyle="bold"
              android:textSize="14sp"/>
          <TextView
              android:id="@+id/desc_rank_1"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/name_rank_1"
              android:layout_toEndOf="@id/txt_rank_1"
              android:layout_marginStart="8dp"
              android:text="Level 5 • 8.3 km (halaman)"
              android:textColor="#888888"
              android:textSize="11sp"/>
          <TextView
              android:id="@+id/val_rank_1"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:text="45 Menit"
              android:textColor="#FF6D00"
              android:textStyle="bold"
              android:textSize="14sp"/>
        </RelativeLayout>
      </androidx.cardview.widget.CardView>

      <!-- Rank 2 -->
      <androidx.cardview.widget.CardView
          android:id="@+id/card_rank_2"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp">
        <RelativeLayout
            android:id="@+id/bg_rank_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFFFFF">
          <TextView
              android:id="@+id/txt_rank_2"
              android:layout_width="24dp"
              android:layout_height="wrap_content"
              android:text="🥈"
              android:textSize="16sp"
              android:layout_centerVertical="true"/>
          <TextView
              android:id="@+id/name_rank_2"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_toEndOf="@id/txt_rank_2"
              android:layout_marginStart="8dp"
              android:text="Yusuf Amin"
              android:textColor="#333333"
              android:textStyle="bold"
              android:textSize="14sp"/>
          <TextView
              android:id="@+id/desc_rank_2"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/name_rank_2"
              android:layout_toEndOf="@id/txt_rank_2"
              android:layout_marginStart="8dp"
              android:text="Level 3 • 4.5 km (halaman)"
              android:textColor="#888888"
              android:textSize="11sp"/>
          <TextView
              android:id="@+id/val_rank_2"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:text="30 Menit"
              android:textColor="#FF6D00"
              android:textStyle="bold"
              android:textSize="14sp"/>
        </RelativeLayout>
      </androidx.cardview.widget.CardView>

      <!-- Rank 3 -->
      <androidx.cardview.widget.CardView
          android:id="@+id/card_rank_3"
          android:layout_width="match_parent"
          android:layout_height="wrap_content"
          android:layout_marginBottom="8dp"
          app:cardCornerRadius="12dp"
          app:cardElevation="1dp">
        <RelativeLayout
            android:id="@+id/bg_rank_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="12dp"
            android:background="#FFF3E0"> <!-- Light orange for highlight -->
          <TextView
              android:id="@+id/txt_rank_3"
              android:layout_width="24dp"
              android:layout_height="wrap_content"
              android:text="🥉"
              android:textSize="16sp"
              android:layout_centerVertical="true"/>
          <TextView
              android:id="@+id/name_rank_3"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_toEndOf="@id/txt_rank_3"
              android:layout_marginStart="8dp"
              android:text="Saya (Anda)"
              android:textColor="#333333"
              android:textStyle="bold"
              android:textSize="14sp"/>
          <TextView
              android:id="@+id/desc_rank_3"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_below="@id/name_rank_3"
              android:layout_toEndOf="@id/txt_rank_3"
              android:layout_marginStart="8dp"
              android:text="Level 2 • 2.0 km (halaman)"
              android:textColor="#888888"
              android:textSize="11sp"/>
          <TextView
              android:id="@+id/val_rank_3"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_alignParentEnd="true"
              android:layout_centerVertical="true"
              android:text="15 Menit"
              android:textColor="#FF6D00"
              android:textStyle="bold"
              android:textSize="14sp"/>
        </RelativeLayout>
      </androidx.cardview.widget.CardView>

    </LinearLayout>
  </ScrollView>
</LinearLayout>
