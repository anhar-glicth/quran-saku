<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Judul Kegiatan"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_event_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Kajian Fiqih Ramadhan"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kategori"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <Spinner
            android:id="@+id/sp_event_category"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Deskripsi"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_event_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Tulis deskripsi acara..."
            android:textSize="14sp"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pembicara / Pemateri"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_event_speaker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Ustadz Adi Hidayat"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tanggal Kegiatan"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_event_date"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="YYYY-MM-DD"
            android:textSize="14sp"
            android:focusable="false"
            android:clickable="true"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Waktu Acara"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_event_time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: 09:00 - 11:00 WIB"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tempat / Lokasi"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_event_location"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: Online Zoom / Masjid Istiqlal"
            android:textSize="14sp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Link Meeting (Zoom) / Google Maps (Opsional)"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <EditText
            android:id="@+id/et_event_link_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://zoom.us/j/... atau https://maps.google.com/..."
            android:textSize="13sp"
            android:inputType="textUri"
            android:layout_marginBottom="16dp"/>

        <!-- ── Foto Event Section ── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Foto Event (Opsional)"
            android:textColor="#555555"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp"/>

        <!-- Preview foto terpilih -->
        <com.google.android.material.card.MaterialCardView
            xmlns:app="http://schemas.android.com/apk/res-auto"
            android:id="@+id/card_event_photo_preview"
            android:layout_width="match_parent"
            android:layout_height="140dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="#FFDDDD"
            android:layout_marginBottom="8dp">

            <ImageView
                android:id="@+id/img_event_photo_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/bg_home_verse_card"/>

            <!-- Overlay teks "Ketuk untuk ganti foto" -->
            <TextView
                android:id="@+id/tv_photo_placeholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="📷 Ketuk untuk pilih foto"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:background="#88000000"
                android:padding="8dp"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Tombol pilih foto dari galeri -->
        <Button
            android:id="@+id/btn_pick_photo"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="📁 Pilih Foto dari Galeri"
            android:textSize="12sp"
            android:textColor="#FF6D00"
            android:backgroundTint="#FFF3E0"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="— atau masukkan URL foto langsung —"
            android:textColor="#AAAAAA"
            android:textSize="11sp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/et_event_image_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://example.com/foto.jpg"
            android:textSize="13sp"
            android:inputType="textUri"
            android:layout_marginBottom="16dp"/>

        <CheckBox
            android:id="@+id/cb_featured"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jadikan Event Unggulan (Banner Utama)"
            android:textSize="13sp"/>

    </LinearLayout>
</ScrollView>

