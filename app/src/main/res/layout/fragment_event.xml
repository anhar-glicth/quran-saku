<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F9F9">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="none"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:clipToPadding="false">

            <!-- Search Bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_search_bar"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@android:drawable/ic_menu_search"
                    app:tint="#888888" />

                <EditText
                    android:id="@+id/edt_search_events"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Cari kegiatan kajian..."
                    android:background="@null"
                    android:layout_marginStart="8dp"
                    android:textSize="13sp"
                    android:textColor="#212121"
                    android:textColorHint="#888888"
                    android:singleLine="true" />
            </LinearLayout>

            <!-- Loading indicator -->
            <ProgressBar
                android:id="@+id/progress_events"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginVertical="16dp"
                android:visibility="gone" />

            <!-- Empty State -->
            <TextView
                android:id="@+id/tv_events_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Belum ada event terjadwal."
                android:textColor="#999999"
                android:textSize="13sp"
                android:gravity="center"
                android:padding="20dp"
                android:visibility="gone" />

            <!-- Featured Event Banner -->
            <LinearLayout
                android:id="@+id/layout_featured_event"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Event Unggulan"
                    android:textColor="#212121"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="1dp"
                    app:strokeWidth="1dp"
                    app:strokeColor="#FFEAEAEA"
                    app:cardBackgroundColor="#FFFFFF"
                    android:layout_marginBottom="24dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="130dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:src="@drawable/bg_home_verse_card"
                                android:scaleType="centerCrop" />

                            <TextView
                                android:id="@+id/tv_featured_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="KAJIAN"
                                android:textColor="#FFFFFF"
                                android:background="@drawable/bg_button_aamiinkan"
                                android:textSize="9sp"
                                android:textStyle="bold"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:layout_margin="12dp" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="14dp">

                            <TextView
                                android:id="@+id/tv_featured_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Meaningful Life in Islam"
                                android:textColor="#212121"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_featured_desc"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Kajian mendalam menemukan arti hidup Islami..."
                                android:textColor="#666666"
                                android:textSize="12sp"
                                android:layout_marginTop="4dp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center_vertical"
                                android:layout_marginTop="10dp">

                                <ImageView
                                    android:layout_width="14dp"
                                    android:layout_height="14dp"
                                    android:src="@drawable/ic_event"
                                    app:tint="#888888" />

                                <TextView
                                    android:id="@+id/tv_featured_time"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hari ini • 09:00 WIB"
                                    android:textColor="#666666"
                                    android:textSize="11sp"
                                    android:layout_marginStart="6dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/btn_register_featured"
                                android:layout_width="match_parent"
                                android:layout_height="38dp"
                                android:background="@drawable/bg_card_doa"
                                android:clickable="true"
                                android:focusable="true"
                                android:gravity="center"
                                android:layout_marginTop="12dp">
                                <TextView
                                    android:id="@+id/txt_featured_btn"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Daftar Sekarang"
                                    android:textColor="#FFFFFF"
                                    android:textStyle="bold"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- Upcoming Events Section Header -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Kegiatan Mendatang"
                android:textColor="#212121"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"/>

            <!-- List Kegiatan -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_events"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </ScrollView>

    <!-- FAB Tambah Event (Admin Only) -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_add_event"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="20dp"
        android:src="@android:drawable/ic_input_add"
        app:tint="#FFFFFF"
        app:backgroundTint="@color/accent_color"
        android:visibility="gone" />

</RelativeLayout>
